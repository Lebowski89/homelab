---

# Generated by Ansible for {{ tr_router_name }}
http:
  middlewares:
    {{ tr_router_name }}-ui-chain:
      chain:
        middlewares:
{% if tr_authelia_enable %}
          - "authelia@file"
{% endif %}
          - "secure-headers@file"
          - "robots-noindex@file"
          - "hsts@file"
          - "gzip@file"

  routers:
    {{ tr_router_name }}:
      entryPoints: ["https"]
      rule: "Host(`{{ tr_address }}`)"
      priority: 20
      tls:
        options: "securetls@file"
      middlewares: ["{{ tr_router_name }}-ui-chain"]
      service: "{{ tr_router_name }}-svc"

  services:
    {{ tr_router_name }}-svc:
      loadBalancer:
        servers:
          - url: "{{ tr_backend_address }}"

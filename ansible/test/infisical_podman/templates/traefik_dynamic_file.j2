---

# Generated by Ansible for {{ infisical_podman_name }}

http:
  middlewares:
    {{ infisical_podman_name }}-ui-chain:
      chain:
        middlewares:
{% if infisical_podman_traefik_crowdsec_enable | bool %}
          - "crowdsec@file"
{% endif %}
{% if infisical_podman_traefik_authelia_enable | bool %}
          - "authelia@file"
{% endif %}
          - "{{ infisical_podman_traefik_headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
          - "gzip@file"

  routers:
    {{ infisical_podman_name }}:
      entryPoints: ["{{ infisical_podman_traefik_entrypoint }}"]
      rule: "Host(`{{ infisical_podman_frontend_fqdn }}`)"
      priority: 20
      tls:
        options: "{{ infisical_podman_traefik_tls_options }}"
        certResolver: "{{ infisical_podman_traefik_certresolver }}"
      middlewares: ["{{ infisical_podman_traefik_middleware_chain }}"]
      service: "{{ infisical_podman_name }}-svc"

  services:
    {{ infisical_podman_name }}-svc:
      loadBalancer:
        servers:
          - url: "{{ infisical_podman_backend_address }}"

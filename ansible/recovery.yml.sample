---
# Save privately outside the repository and replace placeholders from operator records.
# No dynamic inventory or local execution. Do not place secrets in this file.
all:
  children:
    service_recovery:
      hosts:
        mgt:
          ansible_connection: ssh
          ansible_host: REPLACE_WITH_VERIFIED_MGT_SSH_ADDRESS
          ansible_user: REPLACE_WITH_MGT_SSH_USER
          ansible_port: 22
          recovery_application_host: mgt
          ansible_python_interpreter: /opt/ansible/ansible-venv/bin/python
          local_ip: REPLACE_WITH_MGT_PRIMARY_LAN_IP
          container_host_puid: REPLACE_WITH_EXISTING_UID
          container_host_pgid: REPLACE_WITH_EXISTING_GID
          container_host_appdata_root: REPLACE_WITH_EXISTING_APPLICATION_ROOT
          services_internal_zone: REPLACE_WITH_INTERNAL_ZONE
          services_private_https_port: 8443
          timezone: Australia/Melbourne
# Bootstrap secrets are separate encrypted Vault inputs, supplied explicitly with -e @path.
# Preserve existing runtime/account/route/protection settings as well as these basics.

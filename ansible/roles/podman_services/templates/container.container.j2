# Generated by Ansible. Do not edit manually.
{% set container_systemd = podman_service.container.systemd | default({}) %}
[Unit]
Description={{ podman_service.description }}
{% for after in container_systemd.after | default([]) %}
After={{ after }}
{% endfor %}

[Container]
ContainerName={{ podman_service.unit_name }}
Image={{ podman_service.image }}
{% if podman_service.network %}
Network={{ podman_service.network.name }}.network
{% endif %}
{% if podman_service.env | length > 0 %}
EnvironmentFile={{ podman_services_quadlet_dir }}/{{ podman_service.unit_name }}.env
{% endif %}
{% if podman_service.container.uid is defined %}
User={{ podman_service.container.uid }}
Group={{ podman_service.container.gid }}
{% endif %}
{% for volume in podman_service.volumes | sort(attribute='name') %}
{% set volume_read_only = volume.read_only | default(false) %}
Volume={{ volume.name }}.volume:{{ volume.target }}{{ ':ro' if volume_read_only else '' }}
{% endfor %}
{% for secret in podman_service.secrets | sort(attribute='name') %}
Secret={{ secret.name }},target={{ secret.target | default('/run/secrets/' ~ secret.name) }},uid={{ secret.uid | default(podman_service.container.uid | default('0')) }},gid={{ secret.gid | default(podman_service.container.gid | default('0')) }},mode={{ secret.mode | default('0400') }}
{% endfor %}
{% for port in podman_service.container.ports | default([]) %}
PublishPort={% if port.host_ip is defined %}{{ port.host_ip }}:{% endif %}{{ port.host }}:{{ port.container }}/{{ port.protocol | default('tcp') }}
{% endfor %}
{% for volume in podman_service.container.mounts | default([]) %}
{% set volume_read_only = volume.read_only | default(false) %}
Volume={{ volume.source }}:{{ volume.target }}{{ ':ro' if volume_read_only else '' }}
{% endfor %}
{% for tmpfs in podman_service.container.tmpfs | default([]) %}
{% set tmpfs_options = tmpfs.options | default([]) %}
Tmpfs={{ tmpfs.target }}{{ (':' ~ (tmpfs_options | join(','))) if (tmpfs_options | length > 0) else '' }}
{% endfor %}
{% for cap in podman_service.container.cap_add | default([]) %}
AddCapability={{ cap }}
{% endfor %}
{% for cap in podman_service.container.cap_drop | default([]) %}
DropCapability={{ cap }}
{% endfor %}
{% if podman_service.container.no_new_privileges | default(true) %}
NoNewPrivileges=true
{% endif %}
{% if podman_service.container.read_only | default(false) %}
ReadOnly=true
{% endif %}
{% if podman_service.container.healthcheck is defined %}
HealthCmd={{ podman_service.container.healthcheck.command }}
HealthInterval={{ podman_service.container.healthcheck.interval | default('30s') }}
HealthTimeout={{ podman_service.container.healthcheck.timeout | default('10s') }}
HealthRetries={{ podman_service.container.healthcheck.retries | default(3) }}
HealthStartPeriod={{ podman_service.container.healthcheck.start_period | default('60s') }}
{% endif %}

[Service]
Restart={{ container_systemd.restart | default('on-failure') }}
RestartSec={{ container_systemd.restart_sec | default('15s') }}

[Install]
WantedBy=multi-user.target

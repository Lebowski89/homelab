#!/usr/bin/env bash
set -euo pipefail

PLAYBOOK="${PLAYBOOK:-{{ ubuntu_ansible_path }}/playbook.yml}"
INVENTORY="${INVENTORY:-{{ ubuntu_ansible_path }}/netbox.yml}"
ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-{{ ubuntu_ansible_path }}/ansible.cfg}"
BECOME_PASS_FILE="${BECOME_PASS_FILE:-{{ ubuntu_ansible_become_pass_file }}}"
VAULT_PASS_FILE="${VAULT_PASS_FILE:-{{ ubuntu_ansible_vault_pass_file }}}"
DOCTOR_PING_TARGET="${SKYNET_DOCTOR_PING_TARGET:-{{ ubuntu_skynet_doctor_ping_target }}}"
DOCKER_SERVICES_VARS="${DOCKER_SERVICES_VARS:-{{ ubuntu_skynet_docker_services_vars }}}"
ANSIBLE_VENV_PATH="${ANSIBLE_VENV_PATH:-{{ ubuntu_ansible_venv_path }}}"

DEFAULT_REPO_ROOT="$(cd "$(dirname "$PLAYBOOK")/.." >/dev/null 2>&1 && pwd || true)"
REPO_ROOT="${REPO_ROOT:-$DEFAULT_REPO_ROOT}"
PYTHON_LIBRARY_PATH="${PYTHON_LIBRARY_PATH:-$REPO_ROOT/ansible/roles/docker_services/library}"
ANSIBLE_LOG_PATH="${ANSIBLE_LOG_PATH:-$REPO_ROOT/.ansible/ansible.log}"

tool_path() {
  local name="$1"

  if [[ -x "$ANSIBLE_VENV_PATH/bin/$name" ]]; then
    echo "$ANSIBLE_VENV_PATH/bin/$name"
  else
    echo "$name"
  fi
}

ANSIBLE_PLAYBOOK_BIN="${ANSIBLE_PLAYBOOK_BIN:-$(tool_path ansible-playbook)}"
ANSIBLE_INVENTORY_BIN="${ANSIBLE_INVENTORY_BIN:-$(tool_path ansible-inventory)}"
ANSIBLE_GALAXY_BIN="${ANSIBLE_GALAXY_BIN:-$(tool_path ansible-galaxy)}"
ANSIBLE_BIN="${ANSIBLE_BIN:-$(tool_path ansible)}"
ANSIBLE_LINT_BIN="${ANSIBLE_LINT_BIN:-$(tool_path ansible-lint)}"
YAMLLINT_BIN="${YAMLLINT_BIN:-$(tool_path yamllint)}"
RUFF_BIN="${RUFF_BIN:-$(tool_path ruff)}"

usage() {
  cat <<'EOF'
Usage:
  skynet deploy <tag> [tag2 ...]
  skynet update <tag|all> [tag2 ...]
  skynet remove <tag> [tag2 ...]
  skynet recreate <tag> [tag2 ...]
  skynet bootstrap <tag> [tag2 ...]
  skynet check <tag> [tag2 ...]
  skynet doctor [--ping]
  skynet syntax
  skynet lint
  skynet ci
  skynet versions
  skynet inventory [--graph|--list]
  skynet limit <hostpattern> <deploy|update|remove|recreate|bootstrap|check|raw> ...
  skynet tags
  skynet raw <ansible-playbook args...>
  skynet help

Aliases:
  skynet install  -> deploy
  skynet reset    -> remove

Optional env vars:
  PLAYBOOK                    Override playbook path
  INVENTORY                   Override inventory path
  ANSIBLE_CONFIG              Override ansible.cfg path
  BECOME_PASS_FILE            Override become password file path
  VAULT_PASS_FILE             Override Ansible Vault password file path
  DOCKER_SERVICES_VARS        Override docker services vars path
  ANSIBLE_VENV_PATH           Override Ansible virtualenv path
  SKYNET_DOCTOR_PING_TARGET   Inventory target for 'skynet doctor --ping'
  ANSIBLE_PLAYBOOK_BIN        Override ansible-playbook binary
  ANSIBLE_INVENTORY_BIN       Override ansible-inventory binary
  ANSIBLE_GALAXY_BIN          Override ansible-galaxy binary
  ANSIBLE_BIN                 Override ansible binary (for ping)
  ANSIBLE_LINT_BIN            Override ansible-lint binary
  YAMLLINT_BIN                Override yamllint binary
  RUFF_BIN                    Override ruff binary
  REPO_ROOT                   Override repository root used by lint/ci
  PYTHON_LIBRARY_PATH         Override custom Ansible module Python path for Ruff/ansible-lint
EOF
  exit 1
}

die() { echo "Error: $*" >&2; exit 1; }

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

bin_exists() {
  local bin="$1"
  [[ -n "$bin" ]] && { [[ -x "$bin" ]] || cmd_exists "$bin"; }
}

require_bin() {
  local bin="$1"
  local name="$2"

  if ! bin_exists "$bin"; then
    die "$name not found/executable: $bin"
  fi
}

run_yaml_lint() {
  require_bin "$YAMLLINT_BIN" yamllint

  [[ -n "$REPO_ROOT" ]] || die "Unable to determine REPO_ROOT; set REPO_ROOT manually"
  [[ -d "$REPO_ROOT" ]] || die "REPO_ROOT does not exist: $REPO_ROOT"

  local -a yaml_files=()

  if [[ -d "$REPO_ROOT/.git" ]] && cmd_exists git; then
    mapfile -t yaml_files < <(cd "$REPO_ROOT" && git ls-files '*.yml' '*.yaml')
  else
    mapfile -t yaml_files < <(
      find "$REPO_ROOT" -type f \( -name '*.yml' -o -name '*.yaml' \) \
        -not -path '*/.git/*' \
        -not -path '*/ansible/collections/*' \
        -not -path '*/.ansible/*'
    )
  fi

  if [[ ${yaml_files[0]+_} != _ ]]; then
    echo "[INFO] No YAML files found"
    return 0
  fi

  echo "[INFO] Running yamllint"
  (cd "$REPO_ROOT" && "$YAMLLINT_BIN" "${yaml_files[@]}")
}

run_python_lint() {
  require_bin "$RUFF_BIN" ruff

  if [[ ! -d "$PYTHON_LIBRARY_PATH" ]]; then
    echo "[WARN] Python library path not found; skipping Ruff: $PYTHON_LIBRARY_PATH"
    return 0
  fi

  echo "[INFO] Running Ruff check"
  (cd "$REPO_ROOT" && "$RUFF_BIN" check --output-format=github "$PYTHON_LIBRARY_PATH")

  echo "[INFO] Running Ruff format check"
  (cd "$REPO_ROOT" && "$RUFF_BIN" format --check --diff "$PYTHON_LIBRARY_PATH")
}

run_ansible_lint() {
  require_bin "$ANSIBLE_LINT_BIN" ansible-lint

  [[ -n "$REPO_ROOT" ]] || die "Unable to determine REPO_ROOT; set REPO_ROOT manually"
  mkdir -p "$(dirname "$ANSIBLE_LOG_PATH")"

  echo "[INFO] Running ansible-lint"
  (
    cd "$REPO_ROOT"
    ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
      ANSIBLE_LIBRARY="$PYTHON_LIBRARY_PATH" \
      ANSIBLE_LOG_PATH="$ANSIBLE_LOG_PATH" \
      "$ANSIBLE_LINT_BIN" --format=pep8
  )
}

run_lint() {
  run_yaml_lint
  run_python_lint
  run_ansible_lint
}

print_versions() {
  echo "[INFO] repo root: ${REPO_ROOT:-unknown}"
  echo "[INFO] playbook: $PLAYBOOK"
  echo "[INFO] inventory: $INVENTORY"
  echo "[INFO] ansible config: $ANSIBLE_CONFIG"

  local -a tools=(
    "$ANSIBLE_PLAYBOOK_BIN"
    "$ANSIBLE_INVENTORY_BIN"
    "$ANSIBLE_GALAXY_BIN"
    "$ANSIBLE_BIN"
    "$ANSIBLE_LINT_BIN"
    "$YAMLLINT_BIN"
    "$RUFF_BIN"
  )

  local tool
  for tool in "${tools[@]}"; do
    if bin_exists "$tool"; then
      echo "[OK] $tool"
      "$tool" --version 2>/dev/null | head -n 1 || true
    else
      echo "[WARN] missing: $tool"
    fi
  done
}

join_csv() {
  local IFS=,
  echo "$*"
}

run_playbook() {
  local -a args=()
  args=(-i "$INVENTORY" "$PLAYBOOK")

  if [[ -f "$BECOME_PASS_FILE" ]]; then
    args+=(--become-password-file "$BECOME_PASS_FILE")
  else
    echo "[WARN] Become password file not found: $BECOME_PASS_FILE"
    echo "[WARN] If sudo requires a password, set BECOME_PASS_FILE or create .ansible_become_pass"
  fi

  if [[ -f "$VAULT_PASS_FILE" ]]; then
    args+=(--vault-password-file "$VAULT_PASS_FILE")
  else
    echo "[WARN] Vault password file not found: $VAULT_PASS_FILE"
    echo "[WARN] If vaulted vars are used, set VAULT_PASS_FILE or create .ansible_vault_pass"
  fi

  ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_PLAYBOOK_BIN" "${args[@]}" "$@"
}

print_tags() {
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$PLAYBOOK" "$DOCKER_SERVICES_VARS" <<'PY'
import sys
from collections import OrderedDict

playbook_path = sys.argv[1]
docker_services_path = sys.argv[2]

try:
    import yaml
except Exception:
    yaml = None

tags = OrderedDict()

def add(x):
    if isinstance(x, str):
        x = x.strip()
        if x and x not in tags:
            tags[x] = True

if not yaml:
    sys.exit("python yaml module is required for skynet tags")

try:
    with open(playbook_path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or []
    if isinstance(data, list):
        for play in data:
            if not isinstance(play, dict):
                continue
            ds = (play.get("vars") or {}).get("docker_services", [])
            if isinstance(ds, list):
                for item in ds:
                    if not isinstance(item, dict):
                        continue
                    add(item.get("name"))
                    for t in (item.get("tags") or []):
                        add(t)
except FileNotFoundError:
    pass

try:
    with open(docker_services_path, "r", encoding="utf-8") as f:
        gv = yaml.safe_load(f) or {}
    ds = gv.get("docker_services", [])
    if isinstance(ds, list):
        for item in ds:
            if not isinstance(item, dict):
                continue
            add(item.get("name"))
            for t in (item.get("tags") or []):
                add(t)
except FileNotFoundError:
    pass

for t in tags:
    print(t)
PY
  else
    echo "[WARN] python3 not found; falling back to best-effort tag parsing from playbook only" >&2
    grep -E '^\s*- name:|^\s*tags:\s*\[' "$PLAYBOOK" \
      | sed -E 's/^\s*- name:\s*//; s/^\s*tags:\s*\[//; s/\]\s*$//' \
      | tr ',' '\n' | sed 's/^ *//; s/ *$//' | sort -u
  fi
}

doctor() {
  local do_ping="${1:-false}"

  echo "[INFO] playbook: $PLAYBOOK"
  echo "[INFO] inventory: $INVENTORY"
  echo "[INFO] ansible config: $ANSIBLE_CONFIG"
  echo "[INFO] ansible venv path: $ANSIBLE_VENV_PATH"

  [[ -f "$PLAYBOOK" ]] && echo "[OK] playbook found: $PLAYBOOK" || die "Missing playbook: $PLAYBOOK"
  [[ -f "$INVENTORY" ]] && echo "[OK] inventory found: $INVENTORY" || die "Missing inventory: $INVENTORY"
  [[ -f "$ANSIBLE_CONFIG" ]] && echo "[OK] ansible.cfg found: $ANSIBLE_CONFIG" || die "Missing ansible.cfg: $ANSIBLE_CONFIG"

  bin_exists "$ANSIBLE_PLAYBOOK_BIN" || die "ansible-playbook not found/executable: $ANSIBLE_PLAYBOOK_BIN"
  bin_exists "$ANSIBLE_INVENTORY_BIN" || die "ansible-inventory not found/executable: $ANSIBLE_INVENTORY_BIN"

  echo "[OK] ansible-playbook: $ANSIBLE_PLAYBOOK_BIN"
  if "$ANSIBLE_PLAYBOOK_BIN" --version >/dev/null 2>&1; then
    echo "[OK] ansible-playbook version check passed"
  else
    die "ansible-playbook --version failed"
  fi

  if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_INVENTORY_BIN" -i "$INVENTORY" --list >/dev/null 2>&1; then
    echo "[OK] inventory parses"
  else
    die "ansible-inventory --list failed"
  fi

  if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY" "$PLAYBOOK" --syntax-check >/dev/null 2>&1; then
    echo "[OK] playbook syntax check passed"
  else
    die "playbook syntax check failed"
  fi

  if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY" "$PLAYBOOK" --list-tags >/dev/null 2>&1; then
    echo "[OK] --list-tags works"
  else
    echo "[WARN] --list-tags failed"
  fi

  if [[ -f "$DOCKER_SERVICES_VARS" ]]; then
    echo "[OK] docker services vars found: $DOCKER_SERVICES_VARS"
  else
    echo "[WARN] docker services vars not found: $DOCKER_SERVICES_VARS"
  fi

  if [[ -f "$VAULT_PASS_FILE" ]]; then
    echo "[OK] vault password file found: $VAULT_PASS_FILE"
  else
    echo "[WARN] vault password file not found: $VAULT_PASS_FILE"
  fi

  if bin_exists "$ANSIBLE_GALAXY_BIN"; then
    if "$ANSIBLE_GALAXY_BIN" collection list 2>/dev/null | grep -q 'community.docker'; then
      echo "[OK] community.docker collection found"
    else
      echo "[WARN] community.docker collection not found"
    fi

    if "$ANSIBLE_GALAXY_BIN" collection list 2>/dev/null | grep -q 'netbox.netbox'; then
      echo "[OK] netbox.netbox collection found"
    else
      echo "[WARN] netbox.netbox collection not found"
    fi
  else
    echo "[WARN] ansible-galaxy not found/executable at '$ANSIBLE_GALAXY_BIN' (skipping collection checks)"
  fi

  if [[ "$do_ping" == "true" ]]; then
    if bin_exists "$ANSIBLE_BIN"; then
      if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_BIN" -i "$INVENTORY" "$DOCTOR_PING_TARGET" -m ping >/dev/null 2>&1; then
        echo "[OK] ansible ping to '$DOCTOR_PING_TARGET' passed"
      else
        echo "[WARN] ansible ping to '$DOCTOR_PING_TARGET' failed"
      fi
    else
      echo "[WARN] ansible binary not executable at '$ANSIBLE_BIN' (skipping ping)"
    fi
  fi

  echo "[OK] doctor complete"
}

LIMIT_ARGS=()

CMD="${1:-}"
[[ -n "$CMD" ]] || usage
shift || true

if [[ "$CMD" == "limit" ]]; then
  [[ $# -ge 2 ]] || die "Usage: skynet limit <hostpattern> <command> ..."
  LIMIT_ARGS=(--limit "$1")
  shift
  CMD="$1"
  shift
fi

case "$CMD" in
  install) CMD="deploy" ;;
  reset)   CMD="remove" ;;
esac

case "$CMD" in
  deploy)
    [[ $# -ge 1 ]] || die "deploy requires at least one tag"
    TAGS="deploy,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$TAGS"
    ;;

  update)
    [[ $# -ge 1 ]] || die "update requires at least one tag or 'all'"
    if [[ "$1" == "all" ]]; then
      run_playbook "${LIMIT_ARGS[@]}" --tags "update,all"
    else
      TAGS="update,$(join_csv "$@")"
      run_playbook "${LIMIT_ARGS[@]}" --tags "$TAGS"
    fi
    ;;

  remove)
    [[ $# -ge 1 ]] || die "remove requires at least one tag"
    TAGS="remove,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$TAGS"
    ;;

  recreate)
    [[ $# -ge 1 ]] || die "recreate requires at least one tag"
    TAGS="recreate,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$TAGS"
    ;;

  bootstrap)
    [[ $# -ge 1 ]] || die "bootstrap requires at least one tag"
    TAGS="bootstrap,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$TAGS"
    ;;

  check|dry-run)
    [[ $# -ge 1 ]] || die "check requires at least one tag"
    TAGS="deploy,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --check --diff --tags "$TAGS"
    ;;

  doctor)
    if [[ "${1:-}" == "--ping" ]]; then
      doctor true
    else
      doctor false
    fi
    ;;

  syntax)
    run_playbook "${LIMIT_ARGS[@]}" --syntax-check
    ;;

  lint)
    run_lint
    ;;

  ci)
    run_lint
    doctor false
    ;;

  versions)
    print_versions
    ;;

  inventory)
    MODE="${1:---graph}"
    case "$MODE" in
      --graph|graph)
        ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_INVENTORY_BIN" -i "$INVENTORY" --graph
        ;;
      --list|list)
        ANSIBLE_CONFIG="$ANSIBLE_CONFIG" "$ANSIBLE_INVENTORY_BIN" -i "$INVENTORY" --list
        ;;
      *)
        die "Usage: skynet inventory [--graph|--list]"
        ;;
    esac
    ;;

  tags|list)
    print_tags
    ;;

  raw)
    [[ $# -ge 1 ]] || die "raw requires ansible-playbook args"
    run_playbook "${LIMIT_ARGS[@]}" "$@"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    die "Unknown command: $CMD"
    ;;
esac

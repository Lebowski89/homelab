    *)
      return 1
      ;;
  esac
}

is_role_target() {
  local target="${1:-}"

  role_tag "$target" deploy >/dev/null 2>&1
}

run_role_or_docker_action() {
  local command="$1"
  local default_role_action="$2"
  shift 2

  [[ $# -ge 1 ]] || die "$command requires at least one tag, role target, or 'all'"

  if [[ "$1" == "all" ]]; then
    run_docker_service_action "$command" "$@"
  elif [[ $# -le 2 ]]; then
    local tags

    if tags="$(role_tag "$1" "${2:-$default_role_action}")"; then
      run_playbook "${LIMIT_ARGS[@]}" --tags "$tags"
    elif is_role_target "$1"; then
      die "Unknown role target/action: $1 ${2:-$default_role_action}. Run: skynet targets"
    else
      run_docker_service_action "$command" "$@"
    fi
  else
    run_docker_service_action "$command" "$@"
  fi
}

run_check_action() {
  [[ $# -ge 1 ]] || die "check requires at least one tag, role target, or 'all'"

  if [[ "$1" == "all" ]]; then
    [[ $# -eq 1 ]] || die "Usage: skynet check all"
    run_playbook "${LIMIT_ARGS[@]}" --check --diff --tags "deploy" -e docker_services_run_all=true
  elif [[ $# -le 2 ]]; then
    local tags
    if tags="$(role_tag "$1" "${2:-deploy}")"; then
      run_playbook "${LIMIT_ARGS[@]}" --check --diff --tags "$tags"
    else
      tags="deploy,$(join_csv "$@")"
      run_playbook "${LIMIT_ARGS[@]}" --check --diff --tags "$tags"
    fi
  else
    local tags
    tags="deploy,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --check --diff --tags "$tags"
  fi
}

run_drift_action() {
  [[ $# -ge 1 ]] || die "drift requires at least one tag or 'all'"

  if [[ "$1" == "all" ]]; then
    [[ $# -eq 1 ]] || die "Usage: skynet drift all"
    run_playbook "${LIMIT_ARGS[@]}" --tags "drift" -e docker_services_run_all=true
  else
    local tags
    tags="drift,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$tags"
  fi
}


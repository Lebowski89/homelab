run_playbook() {
  local -a args=()
  args=(-i "$INVENTORY" "$PLAYBOOK")

  if [[ -f "$BECOME_PASS_FILE" ]]; then
    args+=(--become-password-file "$BECOME_PASS_FILE")
  else
    echo "[WARN] Become password file not found: $BECOME_PASS_FILE"
    echo "[WARN] If sudo requires a password, set BECOME_PASS_FILE or create .ansible_become_pass"
  fi

  if [[ -f "$VAULT_PASS_FILE" ]]; then
    args+=(--vault-password-file "$VAULT_PASS_FILE")
  else
    echo "[WARN] Vault password file not found: $VAULT_PASS_FILE"
    echo "[WARN] If vaulted vars are used, set VAULT_PASS_FILE or create .ansible_vault_pass"
  fi

  mkdir -p "$(dirname "$ANSIBLE_LOG_PATH")"

  ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
    ANSIBLE_LOG_PATH="$ANSIBLE_LOG_PATH" \
    ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
    "$ANSIBLE_PLAYBOOK_BIN" "${args[@]}" "$@"
}

print_tags() {
  {
    echo "# Role/action tags"
    print_targets | awk '/->/ { print $NF }' | sort -u
    echo

    echo "# Docker service tags"
    if command -v python3 >/dev/null 2>&1; then
      python3 - "$DOCKER_SERVICES_DIR" <<'PY'
import sys
from collections import OrderedDict
from pathlib import Path

services_dir = Path(sys.argv[1])

try:
    import yaml
except Exception:
    yaml = None

tags = OrderedDict()

def add(value):
    if isinstance(value, str):
        value = value.strip()
        if value and value not in tags:
            tags[value] = True

def to_bool(value, default=True):
    if value is None:
        return default

    if isinstance(value, bool):
        return value

    if isinstance(value, (int, float)):
        return bool(value)

    if isinstance(value, str):
        value = value.strip().lower()
        if value in {"1", "true", "yes", "y", "on", "enabled"}:
            return True
        if value in {"0", "false", "no", "n", "off", "disabled"}:
            return False

    return default

def is_enabled(mapping):
    if not isinstance(mapping, dict):
        return True
    return to_bool(mapping.get("enabled", True), default=True)

if not yaml:
    sys.exit("python yaml module is required for skynet tags")

if services_dir.is_dir():
    service_files = sorted(list(services_dir.glob("*.yml")) + list(services_dir.glob("*.yaml")))

    for path in service_files:
        try:
            with path.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
        except Exception as exc:
            print(f"[WARN] failed to read service vars file {path}: {exc}", file=sys.stderr)
            continue

        if not isinstance(data, dict):
            continue

        for service_name, service_cfg in data.items():
            if not isinstance(service_cfg, dict):
                continue

            if not is_enabled(service_cfg):
                continue

            add(service_name)

            for tag in service_cfg.get("tags", []) or []:
                add(tag)

            targets = service_cfg.get("targets", {}) or {}
            if isinstance(targets, dict):
                for _target_name, target_cfg in targets.items():
                    if not isinstance(target_cfg, dict):
                        continue

                    if not is_enabled(target_cfg):
                        continue

                    for tag in target_cfg.get("tags", []) or []:
                        add(tag)

for tag in tags:
    print(tag)
PY
    else
      echo "[WARN] python3 not found; falling back to service file names only" >&2

      if [[ -d "$DOCKER_SERVICES_DIR" ]]; then
        find "$DOCKER_SERVICES_DIR" -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) \
          -exec basename {} \; | sed -E 's/\.ya?ml$//' | sort -u
      else
        echo "[WARN] docker services dir not found: $DOCKER_SERVICES_DIR" >&2
      fi
    fi
  } | awk 'NF && !seen[$0]++'
}

doctor() {
  local do_ping="${1:-false}"

  echo "[INFO] playbook: $PLAYBOOK"
  echo "[INFO] inventory: $INVENTORY"
  echo "[INFO] ansible config: $ANSIBLE_CONFIG"
  echo "[INFO] docker services dir: $DOCKER_SERVICES_DIR"
  echo "[INFO] ansible collections path: $ANSIBLE_COLLECTIONS_PATH"
  echo "[INFO] ansible log path: $ANSIBLE_LOG_PATH"
  echo "[INFO] ansible venv path: $ANSIBLE_VENV_PATH"

  [[ -f "$PLAYBOOK" ]] && echo "[OK] playbook found: $PLAYBOOK" || die "Missing playbook: $PLAYBOOK"
  [[ -f "$INVENTORY" ]] && echo "[OK] inventory found: $INVENTORY" || die "Missing inventory: $INVENTORY"
  [[ -f "$ANSIBLE_CONFIG" ]] && echo "[OK] ansible.cfg found: $ANSIBLE_CONFIG" || die "Missing ansible.cfg: $ANSIBLE_CONFIG"

  bin_exists "$ANSIBLE_PLAYBOOK_BIN" || die "ansible-playbook not found/executable: $ANSIBLE_PLAYBOOK_BIN"
  bin_exists "$ANSIBLE_INVENTORY_BIN" || die "ansible-inventory not found/executable: $ANSIBLE_INVENTORY_BIN"

  echo "[OK] ansible-playbook: $ANSIBLE_PLAYBOOK_BIN"
  if "$ANSIBLE_PLAYBOOK_BIN" --version >/dev/null 2>&1; then
    echo "[OK] ansible-playbook version check passed"
  else
    die "ansible-playbook --version failed"
  fi

  if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
    ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
    "$ANSIBLE_INVENTORY_BIN" -i "$INVENTORY" --list >/dev/null 2>&1; then
    echo "[OK] inventory parses"
  else
    die "ansible-inventory --list failed"
  fi

  if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
    ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
    "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY" "$PLAYBOOK" --syntax-check >/dev/null 2>&1; then
    echo "[OK] playbook syntax check passed"
  else
    die "playbook syntax check failed"
  fi

  if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
    ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
    "$ANSIBLE_PLAYBOOK_BIN" -i "$INVENTORY" "$PLAYBOOK" --list-tags >/dev/null 2>&1; then
    echo "[OK] --list-tags works"
  else
    echo "[WARN] --list-tags failed"
  fi

  if [[ -d "$DOCKER_SERVICES_DIR" ]]; then
    echo "[OK] docker services dir found: $DOCKER_SERVICES_DIR"

    if find "$DOCKER_SERVICES_DIR" -maxdepth 1 -type f \( -name '*.yml' -o -name '*.yaml' \) | grep -q .; then
      echo "[OK] docker service vars found in services dir"
    else
      echo "[WARN] no docker service vars found in services dir: $DOCKER_SERVICES_DIR"
    fi
  else
    echo "[WARN] docker services dir not found: $DOCKER_SERVICES_DIR"
  fi

  if [[ -f "$VAULT_PASS_FILE" ]]; then
    echo "[OK] vault password file found: $VAULT_PASS_FILE"
  else
    echo "[WARN] vault password file not found: $VAULT_PASS_FILE"
  fi

  if bin_exists "$ANSIBLE_GALAXY_BIN"; then
    if ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
      "$ANSIBLE_GALAXY_BIN" collection list 2>/dev/null | grep -q 'community.docker'; then
      echo "[OK] community.docker collection found"
    else
      echo "[WARN] community.docker collection not found"
    fi

    if ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
      "$ANSIBLE_GALAXY_BIN" collection list 2>/dev/null | grep -q 'netbox.netbox'; then
      echo "[OK] netbox.netbox collection found"
    else
      echo "[WARN] netbox.netbox collection not found"
    fi

    if ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
      "$ANSIBLE_GALAXY_BIN" collection list 2>/dev/null | grep -q 'ansible.posix'; then
      echo "[OK] ansible.posix collection found"
    else
      echo "[WARN] ansible.posix collection not found"
    fi
  else
    echo "[WARN] ansible-galaxy not found/executable at '$ANSIBLE_GALAXY_BIN' (skipping collection checks)"
  fi

  if [[ "$do_ping" == "true" ]]; then
    if bin_exists "$ANSIBLE_BIN"; then
      if ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
        ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
        "$ANSIBLE_BIN" -i "$INVENTORY" "$DOCTOR_PING_TARGET" -m ping >/dev/null 2>&1; then
        echo "[OK] ansible ping to '$DOCTOR_PING_TARGET' passed"
      else
        echo "[WARN] ansible ping to '$DOCTOR_PING_TARGET' failed"
      fi
    else
      echo "[WARN] ansible binary not executable at '$ANSIBLE_BIN' (skipping ping)"
    fi
  fi

  echo "[OK] doctor complete"
}

LIMIT_ARGS=()

CMD="${1:-}"
[[ -n "$CMD" ]] || usage
shift || true

if [[ "$CMD" == "limit" ]]; then
  [[ $# -ge 2 ]] || die "Usage: skynet limit <hostpattern> <command> ..."
  LIMIT_ARGS=(--limit "$1")
  shift
  CMD="$1"
  shift
fi

case "$CMD" in
  install) CMD="deploy" ;;
  reset)   CMD="remove" ;;
  dry-run) CMD="check" ;;
  target)  CMD="run" ;;
esac

case "$CMD" in
  deploy)
    run_role_or_docker_action deploy deploy "$@"
    ;;

  update)
    run_role_or_docker_action update deploy "$@"
    ;;

  remove)
    run_role_or_docker_action remove remove "$@"
    ;;

  recreate)
    run_role_or_docker_action recreate recreate "$@"
    ;;

  bootstrap)
    run_role_or_docker_action bootstrap bootstrap "$@"
    ;;

  check|dry-run)
    run_check_action "$@"
    ;;

  drift)
    run_drift_action "$@"
    ;;

  run)
    [[ $# -ge 1 ]] || die "run requires a role target"
    [[ $# -le 2 ]] || die "Usage: skynet run <role-target> [action]"

    role_target="$1"
    role_action="${2:-deploy}"

    if tags="$(role_tag "$role_target" "$role_action")"; then
      run_playbook "${LIMIT_ARGS[@]}" --tags "$tags"
    else
      die "Unknown role target/action: $role_target $role_action. Run: skynet targets"
    fi
    ;;

  doctor)
    if [[ "${1:-}" == "--ping" ]]; then
      doctor true
    else
      doctor false
    fi
    ;;

  syntax)
    run_playbook "${LIMIT_ARGS[@]}" --syntax-check
    ;;

  lint)
    run_lint
    ;;

  ci)
    run_lint
    run_unit_tests
    doctor false
    ;;

  versions)
    print_versions
    ;;

  inventory)
    mode="${1:---graph}"
    case "$mode" in
      --graph|graph)
        ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
          ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
          "$ANSIBLE_INVENTORY_BIN" -i "$INVENTORY" --graph
        ;;
      --list|list)
        ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
          ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
          "$ANSIBLE_INVENTORY_BIN" -i "$INVENTORY" --list
        ;;
      *)
        die "Usage: skynet inventory [--graph|--list]"
        ;;
    esac
    ;;

  tags|list)
    print_tags
    ;;

  targets)
    print_targets
    ;;

  raw)
    [[ $# -ge 1 ]] || die "raw requires ansible-playbook args"
    run_playbook "${LIMIT_ARGS[@]}" "$@"
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    die "Unknown command: $CMD"
    ;;
esac

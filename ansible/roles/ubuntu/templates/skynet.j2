  local action="${2:-deploy}"

  target="${target,,}"
  target="${target//_/-}"
  action="${action,,}"
  action="${action//_/-}"

  case "${target}:${action}" in
    netbox:bootstrap)               echo "netbox_bootstrap" ;;
    netbox:deploy)                  echo "netbox_deploy" ;;
    netbox:recreate)                echo "netbox_recreate" ;;
    netbox:remove)                  echo "netbox_remove" ;;

    ubuntu:deploy)                  echo "ubuntu" ;;
    ubuntu:apt)                     echo "ubuntu_apt" ;;
    ubuntu:repo)                    echo "ubuntu_repo" ;;
    ubuntu:venv)                    echo "ubuntu_venv" ;;
    ubuntu:requirements)            echo "ubuntu_requirements" ;;
    ubuntu:skynet)                  echo "ubuntu_skynet" ;;
    ubuntu:sysctl)                  echo "ubuntu_sysctl" ;;
    ubuntu:pam)                     echo "ubuntu_pam" ;;
    ubuntu:network)                 echo "ubuntu_network" ;;
    ubuntu:netplan)                 echo "ubuntu_netplan" ;;

    resolved:deploy)                echo "resolved" ;;
    resolved:run)                   echo "resolved" ;;
    systemd-resolved:deploy)        echo "resolved" ;;
    systemd-resolved:run)           echo "resolved" ;;

    docker:deploy)                  echo "docker" ;;
    docker:install)                 echo "docker_install" ;;
    docker:prune)                   echo "docker_prune" ;;
    docker:prune-dangling)          echo "docker_prune_dangling" ;;
    docker:prune-unused)            echo "docker_prune_unused" ;;
    docker:prune-volumes)           echo "docker_prune_volumes" ;;
    docker:prune-timer)             echo "docker_prune_timer" ;;
    docker:prune-unraid-script)     echo "docker_prune_unraid_user_script" ;;
    docker:swarm)                   echo "docker_swarm" ;;
    docker:swarm-init)              echo "docker_swarm_init" ;;
    docker:swarm-join)              echo "docker_swarm_join" ;;
    docker:swarm-network)           echo "docker_swarm_network" ;;
    docker:swarm-labels)            echo "docker_swarm_labels" ;;

    hugo:bootstrap)                 echo "hugo_bootstrap" ;;
    hugo:deploy)                    echo "hugo_bootstrap" ;;
    hugo:submodule)                 echo "hugo_submodule" ;;

    infisical:bootstrap)            echo "infisical_bootstrap" ;;
    infisical:deploy)               echo "infisical_deploy" ;;
    infisical:recreate)             echo "infisical_recreate" ;;
    infisical:remove)               echo "infisical_remove" ;;

    opentofu:deploy)                echo "opentofu" ;;
    opentofu:install)               echo "opentofu_install" ;;
    opentofu:pve-user)              echo "opentofu_pve_user" ;;

    postgres:deploy)                echo "postgres" ;;
    postgres:apt)                   echo "postgres_apt" ;;
    postgres:etcd)                  echo "postgres_etcd" ;;
    postgres:etcd-reset)            echo "postgres_etcd_reset" ;;
    postgres:patroni)               echo "postgres_patroni" ;;
    postgres:patroni-reset)         echo "postgres_patroni_reset" ;;
    postgres:backup)                echo "postgres_backup" ;;
    postgres:restore)               echo "postgres_restore" ;;
    postgres:admin)                 echo "postgres_admin" ;;
    postgres:admin-uptime-kuma)     echo "postgres_admin_uptime_kuma" ;;
    postgres:admin-nuke-node)       echo "postgres_admin_nuke_node" ;;
    postgres:admin-fix-owner)       echo "postgres_admin_fix_owner" ;;
    postgres:admin-update-pg-hba)   echo "postgres_admin_update_pg_hba" ;;

    podman:deploy)                  echo "podman" ;;
    podman:install)                 echo "podman_install" ;;

    infisical-podman:bootstrap)     echo "infisical_podman_bootstrap" ;;
    infisical-podman:deploy)        echo "infisical_podman_deploy" ;;
    infisical-podman:recreate)      echo "infisical_podman_recreate" ;;
    infisical-podman:remove)        echo "infisical_podman_remove" ;;

    keepalived:deploy)              echo "keepalived" ;;
    keepalived:run)                 echo "keepalived" ;;

    technitium-native:deploy)       echo "technitium_native" ;;
    technitium-native:install)      echo "technitium_native" ;;
    technitium-native:run)          echo "technitium_native" ;;

    node-exporter:deploy)           echo "node_exporter" ;;
    node-exporter:install)          echo "node_exporter" ;;

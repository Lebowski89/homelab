}

die() { echo "Error: $*" >&2; exit 1; }

cmd_exists() { command -v "$1" >/dev/null 2>&1; }

bin_exists() {
  local bin="$1"
  [[ -n "$bin" ]] && { [[ -x "$bin" ]] || cmd_exists "$bin"; }
}

require_bin() {
  local bin="$1"
  local name="$2"

  if ! bin_exists "$bin"; then
    die "$name not found/executable: $bin"
  fi
}

run_yaml_lint() {
  require_bin "$YAMLLINT_BIN" yamllint

  [[ -n "$REPO_ROOT" ]] || die "Unable to determine REPO_ROOT; set REPO_ROOT manually"
  [[ -d "$REPO_ROOT" ]] || die "REPO_ROOT does not exist: $REPO_ROOT"

  local -a yaml_files=()

  if [[ -d "$REPO_ROOT/.git" ]] && cmd_exists git; then
    mapfile -t yaml_files < <(cd "$REPO_ROOT" && git ls-files '*.yml' '*.yaml')
  else
    mapfile -t yaml_files < <(
      find "$REPO_ROOT" -type f \( -name '*.yml' -o -name '*.yaml' \) \
        -not -path '*/.git/*' \
        -not -path '*/ansible/collections/*' \
        -not -path '*/.ansible/*'
    )
  fi

  if [[ ${yaml_files[0]+_} != _ ]]; then
    echo "[INFO] No YAML files found"
    return 0
  fi

  echo "[INFO] Running yamllint"
  (cd "$REPO_ROOT" && "$YAMLLINT_BIN" "${yaml_files[@]}")
}

resolve_existing_paths() {
  local label="$1"
  local input_var="$2"
  local output_var="$3"
  local path

  local -n input_ref="$input_var"
  local -n output_ref="$output_var"

  [[ -n "$REPO_ROOT" ]] || die "Unable to determine REPO_ROOT; set REPO_ROOT manually"
  [[ -d "$REPO_ROOT" ]] || die "REPO_ROOT does not exist: $REPO_ROOT"

  output_ref=()

  for path in "${input_ref[@]}"; do
    if [[ -e "$REPO_ROOT/$path" ]]; then
      output_ref+=("$path")
    else
      echo "[WARN] $label path not found; skipping: $path"
    fi
  done
}

run_python_lint() {
  require_bin "$RUFF_BIN" ruff

  local -a configured_paths=()
  local -a ruff_paths=()

  read -r -a configured_paths <<< "$RUFF_PATHS"
  resolve_existing_paths "Ruff" configured_paths ruff_paths

  if [[ ${ruff_paths[0]+_} != _ ]]; then
    echo "[WARN] No Ruff paths found; skipping Ruff"
    return 0
  fi

  echo "[INFO] Running Ruff check"
  (cd "$REPO_ROOT" && "$RUFF_BIN" check --output-format=github "${ruff_paths[@]}")

  echo "[INFO] Running Ruff format check"
  (cd "$REPO_ROOT" && "$RUFF_BIN" format --check --diff "${ruff_paths[@]}")
}

run_unit_tests() {
  require_bin "$PYTEST_BIN" pytest

  local -a configured_paths=()
  local -a pytest_paths=()

  read -r -a configured_paths <<< "$PYTEST_PATHS"
  resolve_existing_paths "pytest" configured_paths pytest_paths

  if [[ ${pytest_paths[0]+_} != _ ]]; then
    echo "[WARN] No pytest paths found; skipping pytest"
    return 0
  fi

  echo "[INFO] Running pytest"
  (cd "$REPO_ROOT" && "$PYTEST_BIN" "${pytest_paths[@]}")
}

run_ansible_lint() {
  require_bin "$ANSIBLE_LINT_BIN" ansible-lint

  [[ -n "$REPO_ROOT" ]] || die "Unable to determine REPO_ROOT; set REPO_ROOT manually"
  mkdir -p "$(dirname "$ANSIBLE_LOG_PATH")"

  echo "[INFO] Running ansible-lint"
  (
    cd "$REPO_ROOT"
    ANSIBLE_CONFIG="$ANSIBLE_CONFIG" \
      ANSIBLE_LOG_PATH="$ANSIBLE_LOG_PATH" \
      ANSIBLE_COLLECTIONS_PATH="$ANSIBLE_COLLECTIONS_PATH" \
      "$ANSIBLE_LINT_BIN" --format=pep8 ansible
  )
}

run_lint() {
  run_yaml_lint
  run_python_lint
  run_ansible_lint
}

print_versions() {
  echo "[INFO] repo root: ${REPO_ROOT:-unknown}"
  echo "[INFO] playbook: $PLAYBOOK"
  echo "[INFO] inventory: $INVENTORY"
  echo "[INFO] ansible config: $ANSIBLE_CONFIG"
  echo "[INFO] docker services dir: $DOCKER_SERVICES_DIR"
  echo "[INFO] ansible collections path: $ANSIBLE_COLLECTIONS_PATH"
  echo "[INFO] ansible log path: $ANSIBLE_LOG_PATH"

  local -a tools=(
    "$ANSIBLE_PLAYBOOK_BIN"
    "$ANSIBLE_INVENTORY_BIN"
    "$ANSIBLE_GALAXY_BIN"
    "$ANSIBLE_BIN"
    "$ANSIBLE_LINT_BIN"
    "$YAMLLINT_BIN"
    "$RUFF_BIN"
    "$PYTEST_BIN"
  )

  local tool
  for tool in "${tools[@]}"; do
    if bin_exists "$tool"; then
      echo "[OK] $tool"
      "$tool" --version 2>/dev/null | head -n 1 || true
    else
      echo "[WARN] missing: $tool"
    fi
  done
}

join_csv() {
  local IFS=,
  echo "$*"
}

run_docker_service_action() {
  local action="$1"
  shift

  [[ $# -ge 1 ]] || die "$action requires at least one tag or 'all'"

  if [[ "$1" == "all" ]]; then
    [[ $# -eq 1 ]] || die "Usage: skynet $action all"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$action" -e docker_services_run_all=true
  else
    local tags
    tags="$action,$(join_csv "$@")"
    run_playbook "${LIMIT_ARGS[@]}" --tags "$tags"
  fi
}

role_tag() {

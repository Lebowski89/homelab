#!/usr/bin/env bash
set -euo pipefail

PLAYBOOK="${PLAYBOOK:-{{ ubuntu_ansible_path }}/playbook.yml}"
INVENTORY="${INVENTORY:-{{ ubuntu_ansible_path }}/netbox.yml}"
ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-{{ ubuntu_ansible_path }}/ansible.cfg}"
BECOME_PASS_FILE="${BECOME_PASS_FILE:-{{ ubuntu_ansible_become_pass_file }}}"
VAULT_PASS_FILE="${VAULT_PASS_FILE:-{{ ubuntu_ansible_vault_pass_file }}}"
DOCTOR_PING_TARGET="${SKYNET_DOCTOR_PING_TARGET:-{{ ubuntu_skynet_doctor_ping_target }}}"
ANSIBLE_VENV_PATH="${ANSIBLE_VENV_PATH:-{{ ubuntu_ansible_venv_path }}}"

DEFAULT_REPO_ROOT="$(cd "$(dirname "$PLAYBOOK")/.." >/dev/null 2>&1 && pwd || true)"
REPO_ROOT="${REPO_ROOT:-$DEFAULT_REPO_ROOT}"
DOCKER_SERVICES_DIR="${DOCKER_SERVICES_DIR:-$REPO_ROOT/ansible/group_vars/all/services}"
RUFF_PATHS="${RUFF_PATHS:-ansible/filter_plugins ansible/roles/docker_services/filter_plugins ansible/roles/docker_services/library tests/unit}"
PYTEST_PATHS="${PYTEST_PATHS:-tests/unit}"
ANSIBLE_LOG_PATH="${ANSIBLE_LOG_PATH:-$REPO_ROOT/.ansible/ansible.log}"
ANSIBLE_COLLECTIONS_PATH="${ANSIBLE_COLLECTIONS_PATH:-$REPO_ROOT/ansible/collections}"

tool_path() {
  local name="$1"

  if [[ -x "$ANSIBLE_VENV_PATH/bin/$name" ]]; then
    echo "$ANSIBLE_VENV_PATH/bin/$name"
  else
    echo "$name"
  fi
}

ANSIBLE_PLAYBOOK_BIN="${ANSIBLE_PLAYBOOK_BIN:-$(tool_path ansible-playbook)}"
ANSIBLE_INVENTORY_BIN="${ANSIBLE_INVENTORY_BIN:-$(tool_path ansible-inventory)}"
ANSIBLE_GALAXY_BIN="${ANSIBLE_GALAXY_BIN:-$(tool_path ansible-galaxy)}"
ANSIBLE_BIN="${ANSIBLE_BIN:-$(tool_path ansible)}"
ANSIBLE_LINT_BIN="${ANSIBLE_LINT_BIN:-$(tool_path ansible-lint)}"
YAMLLINT_BIN="${YAMLLINT_BIN:-$(tool_path yamllint)}"
RUFF_BIN="${RUFF_BIN:-$(tool_path ruff)}"
PYTEST_BIN="${PYTEST_BIN:-$(tool_path pytest)}"

usage() {
  cat <<'USAGE'
Usage:
  skynet deploy <tag|role-target|all> [tag2|role-action ...]
  skynet update <tag|role-target|all> [tag2|role-action ...]
  skynet remove <tag|role-target|all> [tag2|role-action ...]
  skynet recreate <tag|role-target|all> [tag2|role-action ...]
  skynet bootstrap <tag|role-target|all> [tag2|role-action ...]
  skynet check <tag|role-target|all> [tag2|role-action ...]
  skynet drift <tag|all> [tag2 ...]

  skynet run <role-target> [action]
  skynet check <role-target> [action]

  skynet doctor [--ping]
  skynet syntax
  skynet lint
  skynet ci
  skynet versions
  skynet inventory [--graph|--list]
  skynet limit <hostpattern> <deploy|update|remove|recreate|bootstrap|check|drift|run|raw> ...
  skynet tags
  skynet targets
  skynet raw <ansible-playbook args...>
  skynet help

Aliases:
  skynet install  -> deploy
  skynet reset    -> remove
  skynet dry-run  -> check
  skynet target   -> run

Role/action examples:
  skynet check resolved
  skynet run resolved
  skynet check ubuntu sysctl
  skynet run docker swarm
  skynet run opentofu pve-user
  skynet check infisical-podman
  skynet check infisical-podman recreate
  skynet run infisical-podman deploy
  skynet run infisical-podman remove
  skynet check keepalived
  skynet check technitium-native
  skynet check node-exporter

Docker service examples:
  skynet check authelia
  skynet drift authelia
  skynet recreate authelia
  skynet update all
  skynet drift all

Optional env vars:
  PLAYBOOK                    Override playbook path
  INVENTORY                   Override inventory path
  ANSIBLE_CONFIG              Override ansible.cfg path
  BECOME_PASS_FILE            Override become password file path
  VAULT_PASS_FILE             Override Ansible Vault password file path
  DOCKER_SERVICES_DIR         Override Docker service vars directory
  ANSIBLE_VENV_PATH           Override Ansible virtualenv path
  SKYNET_DOCTOR_PING_TARGET   Inventory target for 'skynet doctor --ping'
  ANSIBLE_PLAYBOOK_BIN        Override ansible-playbook binary
  ANSIBLE_INVENTORY_BIN       Override ansible-inventory binary
  ANSIBLE_GALAXY_BIN          Override ansible-galaxy binary
  ANSIBLE_BIN                 Override ansible binary (for ping)
  ANSIBLE_LINT_BIN            Override ansible-lint binary
  YAMLLINT_BIN                Override yamllint binary
  RUFF_BIN                    Override ruff binary
  PYTEST_BIN                  Override pytest binary
  REPO_ROOT                   Override repository root used by lint/ci
  RUFF_PATHS                  Override space-separated paths for Ruff
  PYTEST_PATHS                Override space-separated paths for pytest
  ANSIBLE_LOG_PATH            Override Ansible log path
  ANSIBLE_COLLECTIONS_PATH    Override Ansible collections path
USAGE

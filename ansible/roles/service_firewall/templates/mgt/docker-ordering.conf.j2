# Managed by skynet mgt endpoints
[Unit]
Requires=skynet-mgt-firewall.service
After=skynet-mgt-firewall.service

[Service]
ExecStartPre={{ mgt_firewall_python | default('/usr/bin/python3') }} {{ mgt_firewall_root }}/policy.py apply --allow-pending --deny-runtime
ExecStartPost={{ mgt_firewall_python | default('/usr/bin/python3') }} {{ mgt_firewall_root }}/policy.py apply --allow-pending

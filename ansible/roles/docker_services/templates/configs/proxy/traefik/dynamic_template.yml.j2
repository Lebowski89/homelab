# Generated by Ansible for {{ tr_router_name }}
http:
  middlewares:
{% if tr_theme_enable %}
    themepark-{{ tr_router_name }}:
      plugin:
        themepark:
          app: "{{ tr_theme_app }}"
          theme: "{{ tr_theme_theme }}"
{% endif %}

    {{ tr_router_name }}-ui-chain:
      chain:
        middlewares:
{% if not tr_private %}
          - "crowdsec@file"
{% endif %}
{% if tr_authelia_enable %}
          - "authelia@file"
{% endif %}
          - "{{ tr_headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
{% if tr_theme_enable %}
          - "themepark-{{ tr_router_name }}@file"
{% endif %}
          - "gzip@file"

    {{ tr_router_name }}-api-chain:
      chain:
        middlewares:
{% if not tr_private %}
          - "crowdsec@file"
{% endif %}
          - "{{ tr_headers_middleware }}"
          - "hsts@file"
          - "gzip@file"

    {{ tr_router_name }}-private-ui-chain:
      chain:
        middlewares:
          - "{{ tr_headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
{% if tr_theme_enable %}
          - "themepark-{{ tr_router_name }}@file"
{% endif %}
          - "gzip@file"

  routers:
    {{ tr_router_name }}:
      entryPoints: ["{{ tr_entrypoint }}"]
      rule: "Host(`{{ tr_address }}`)"
      priority: 20
      tls:
        options: "securetls@file"
        certResolver: "dns-cloudflare"
      middlewares: ["{{ tr_middleware_chain }}"]
      service: "{{ tr_router_name }}-svc"

{% if tr_internal_api and tr_internal_api_matchers | length > 0 %}
    {{ tr_router_name }}-api:
      entryPoints: ["internal"]
      rule: "Host(`{{ tr_address }}`) && ({% for m in tr_internal_api_matchers %}{{ m }}{% if not loop.last %} || {% endif %}{% endfor %})"
      priority: 30
      middlewares: ["{{ tr_router_name }}-api-chain"]
      service: "{{ tr_router_name }}-svc"
{% endif %}

  services:
    {{ tr_router_name }}-svc:
      loadBalancer:
        servers:
          - url: "{{ tr_backend_address }}"
---

global:
  checkNewVersion: false
  sendAnonymousUsage: false

api:
  dashboard: true

log:
  level: DEBUG

accessLog:
  filePath: /etc/traefik/logs/access.log
  bufferingSize: 100
  fields:
    defaultMode: keep

entryPoints:
  internal:
    address: ":8080"

  http:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: https
          scheme: https
          permanent: true
    forwardedHeaders:
      insecure: false
      trustedIPs:
        - 173.245.48.0/20
        - 103.21.244.0/22
        - 103.22.200.0/22
        - 103.31.4.0/22
        - 141.101.64.0/18
        - 108.162.192.0/18
        - 190.93.240.0/20
        - 188.114.96.0/20
        - 197.234.240.0/22
        - 198.41.128.0/17
        - 162.158.0.0/15
        - 104.16.0.0/13
        - 104.24.0.0/14
        - 172.64.0.0/13
        - 131.0.72.0/22
        - 2400:cb00::/32
        - 2606:4700::/32
        - 2803:f800::/32
        - 2405:b500::/32
        - 2405:8100::/32
        - 2a06:98c0::/29
        - 2c0f:f248::/32
    transport:
      respondingTimeouts:
        readTimeout: 600s
        writeTimeout: 0s
        idleTimeout: 180s

  https:
    address: ":443"
    http:
      tls:
        options: securetls@file
        certResolver: dns-cloudflare
        domains:
          - main: {{ cloudflare_zone }}
            sans:
              - "*.{{ cloudflare_zone }}"
    forwardedHeaders:
      insecure: false
      trustedIPs:
        - 173.245.48.0/20
        - 103.21.244.0/22
        - 103.22.200.0/22
        - 103.31.4.0/22
        - 141.101.64.0/18
        - 108.162.192.0/18
        - 190.93.240.0/20
        - 188.114.96.0/20
        - 197.234.240.0/22
        - 198.41.128.0/17
        - 162.158.0.0/15
        - 104.16.0.0/13
        - 104.24.0.0/14
        - 172.64.0.0/13
        - 131.0.72.0/22
        - 2400:cb00::/32
        - 2606:4700::/32
        - 2803:f800::/32
        - 2405:b500::/32
        - 2405:8100::/32
        - 2a06:98c0::/29
        - 2c0f:f248::/32
    transport:
      respondingTimeouts:
        readTimeout: 600s
        writeTimeout: 0s
        idleTimeout: 180s

  https_private:
    address: ":8443"
    http:
      tls:
        options: securetls@file
        certResolver: dns-cloudflare
        domains:
          - main: int.{{ cloudflare_zone }}
            sans:
              - "*.int.{{ cloudflare_zone }}"
    transport:
      respondingTimeouts:
        readTimeout: 600s
        writeTimeout: 0s
        idleTimeout: 180s

  ping:
    address: ":8081"

  metrics:
    address: ":8082"

certificatesResolvers:
  dns-cloudflare:
    acme:
      caServer: https://acme-v02.api.letsencrypt.org/directory
      storage: /etc/traefik/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

experimental:
  plugins:
    themepark:
      moduleName: github.com/packruler/traefik-themepark
      version: v1.4.2

ping:
  entryPoint: ping

metrics:
  prometheus:
    entryPoint: metrics
    buckets:
      - 0.1
      - 0.3
      - 1.2
      - 5.0
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
    manualRouting: false

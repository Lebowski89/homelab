---
###############################################################
#                   Authelia configuration                    #
###############################################################

access_control:
  default_policy: deny
  rules:
#    # LAN: bypass auth for any app host
#    - domain:
#        - "*.{{ cloudflare_zone }}"
#      policy: bypass
#      networks:
#        - "127.0.0.1/32"
#        - "10.0.0.0/8"
#        - "192.168.0.0/16"
#        - "172.16.0.0/12"
#        - "100.64.0.0/10"

    # WAN: require auth
    - domain:
        - "*.{{ cloudflare_zone }}"
        - "{{ cloudflare_zone }}"
      policy: one_factor

server:
  endpoints:
    authz:
      forward-auth:
        implementation: "ForwardAuth"

session:
  cookies:
    - domain: "{{ cloudflare_zone }}"
      authelia_url: "https://authelia.{{ cloudflare_zone }}"
      default_redirection_url: "https://www.{{ cloudflare_zone }}"

notifier:
  disable_startup_check: false
  smtp:
    address: "smtp://{{ smtp_host }}:{{ smtp_port }}"
    username: "{{ smtp_username }}"
    password: "{{ smtp_password }}"
    sender: "{{ smtp_sender }}"

log:
  level: info
  format: text
  file_path: /config/logs/authelia.log
  keep_stdout: true

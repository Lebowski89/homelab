global:
  resolve_timeout: 5m

route:
  receiver: gotify
  group_by: [alertname, cluster, service, job, instance, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: gotify
      matchers:
        - severity="critical"
      repeat_interval: 1h
    - receiver: gotify
      matchers:
        - severity="warning"
      repeat_interval: 6h

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, instance]
  - source_matchers:
      - alertname="PrometheusTargetDown"
    target_matchers:
      - severity=~"warning|critical"
    equal: [job, instance]

receivers:
  - name: gotify
    webhook_configs:
      - url: http://alertmanager-gotify-bridge:8080/gotify_webhook
        send_resolved: true

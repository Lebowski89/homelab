# Generated by Ansible for {{ service_common_traefik.name }}
http:
  middlewares:
{% if service_common_traefik.theme_enabled %}
    themepark-{{ service_common_traefik.name }}:
      plugin:
        themepark:
          app: "{{ service_common_traefik.theme_app }}"
          theme: "{{ service_common_traefik.theme }}"
{% endif %}

    {{ service_common_traefik.name }}-ui-chain:
      chain:
        middlewares:
{% if not service_common_traefik.private %}
          - "crowdsec@file"
{% endif %}
{% if service_common_traefik.authelia_enabled %}
          - "authelia@file"
{% endif %}
          - "{{ service_common_traefik.headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
{% if service_common_traefik.theme_enabled %}
          - "themepark-{{ service_common_traefik.name }}@file"
{% endif %}
          - "gzip@file"

    {{ service_common_traefik.name }}-api-chain:
      chain:
        middlewares:
{% if not service_common_traefik.private %}
          - "crowdsec@file"
{% endif %}
          - "{{ service_common_traefik.headers_middleware }}"
          - "hsts@file"
          - "gzip@file"

    {{ service_common_traefik.name }}-private-ui-chain:
      chain:
        middlewares:
          - "{{ service_common_traefik.headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
{% if service_common_traefik.theme_enabled %}
          - "themepark-{{ service_common_traefik.name }}@file"
{% endif %}
          - "gzip@file"

  routers:
    {{ service_common_traefik.name }}:
      entryPoints: ["{{ service_common_traefik.entrypoint }}"]
      rule: "Host(`{{ service_common_traefik.address }}`)"
      priority: 20
      tls:
        options: "securetls@file"
        certResolver: "dns-cloudflare"
      middlewares: ["{{ service_common_traefik.middleware_chain }}"]
      service: "{{ service_common_traefik.name }}-svc"

{% if service_common_traefik.internal_api and service_common_traefik.internal_api_rules | length > 0 %}
    {{ service_common_traefik.name }}-api:
      entryPoints: ["internal"]
      rule: "Host(`{{ service_common_traefik.address }}`) && ({% for m in service_common_traefik.internal_api_rules %}{{ m }}{% if not loop.last %} || {% endif %}{% endfor %})"
      priority: 30
      middlewares: ["{{ service_common_traefik.name }}-api-chain"]
      service: "{{ service_common_traefik.name }}-svc"
{% endif %}

  services:
    {{ service_common_traefik.name }}-svc:
      loadBalancer:
        servers:
          - url: "{{ service_common_traefik.backend_url }}"
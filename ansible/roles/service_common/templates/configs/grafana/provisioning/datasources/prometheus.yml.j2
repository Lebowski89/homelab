apiVersion: 1

datasources:
  - name: Prometheus
    uid: PBFA97CFB590B2093
    type: prometheus
    access: proxy
    url: https://prometheus.{{ services_internal_zone }}:{{ services_private_https_port }}
    isDefault: true
    editable: true
    jsonData:
      timeInterval: 30s
      alertmanagerUid: alertmanager

  - name: Alertmanager
    uid: alertmanager
    type: alertmanager
    access: proxy
    url: https://alertmanager.{{ services_internal_zone }}:{{ services_private_https_port }}
    editable: true
    jsonData:
      implementation: prometheus
      handleGrafanaManagedAlerts: false

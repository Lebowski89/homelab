{% set secrets = service_common_infisical_values %}
PLEX_PATH=/plex
MODE=move
SCHEDULE=21:00|weekly(monday)|mode=clear,22:00|weekly(monday)|mode=move,23:00|monthly(1)|mode=nothing;photo-transcoder=true
PLEX_URL=http://{{ hostvars[services_plex_host].local_ip }}:32400/
PLEX_TOKEN={{ secrets.plex_token }}
DISCORD=
TIMEOUT=600
SLEEP=60
IGNORE_RUNNING=False
LOCAL_DB=False
USE_EXISTING=False
PHOTO_TRANSCODER=True
EMPTY_TRASH=True
CLEAN_BUNDLES=True
OPTIMIZE_DB=True
TRACE=True
LOG_REQUESTS=True

{% set postgres_pass = service_common_infisical_values.postgres_pass %}
{% set postgres_user = service_common_infisical_values.postgres_user %}
GOTIFY_SERVER_PORT=80
GOTIFY_SERVER_KEEPALIVEPERIODSECONDS=0
GOTIFY_SERVER_STREAM_PINGPERIODSECONDS=45
GOTIFY_DATABASE_DIALECT=postgres
GOTIFY_DATABASE_CONNECTION=host=haproxy port=5432 user={{ postgres_user }} dbname=gotify password={{ postgres_pass }} sslmode=disable
GOTIFY_DEFAULTUSER_PASS=admin
GOTIFY_PASSSTRENGTH=10
GOTIFY_UPLOADEDIMAGESDIR=/app/data/images
GOTIFY_PLUGINSDIR=/app/data/plugins
GOTIFY_REGISTRATION=false

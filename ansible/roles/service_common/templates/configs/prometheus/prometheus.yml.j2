global:
  scrape_interval: 15s
  scrape_timeout: 10s

alerting:
{% include 'configs/prometheus/alertmanager-discovery.yml.j2' %}

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: "prometheus"
    scrape_interval: 5s
    static_configs:
      - targets: ["127.0.0.1:9090"]
        labels:
          instance: "prometheus:9090"

  - job_name: "authelia"
    scrape_interval: 1m
    scrape_timeout: 10s
{% if service_common_service.runtime == 'docker' %}
    static_configs:
      - targets: ["authelia:9959"]
{% elif prometheus_authelia_metrics_address | default('') %}
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ prometheus_authelia_metrics_address }}"]
        labels:
          instance: "authelia:9959"
{% else %}
    metrics_path: /authelia/metrics
    static_configs:
      - targets: ["{{ prometheus_worker_metrics_address }}"]
        labels:
          instance: "authelia:9959"
{% endif %}

{% include 'configs/prometheus/haproxy-scrape.yml.j2' %}

  - job_name: "traefik"
    scrape_interval: 30s
    scrape_timeout: 10s
{% if service_common_service.runtime == 'docker' %}
    static_configs:
      - targets: ["traefik:8082"]
{% else %}
{% if prometheus_traefik_metrics_address | default('') %}
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ prometheus_traefik_metrics_address }}"]
        labels:
          instance: "traefik:8082"
{% else %}
    metrics_path: /traefik/metrics
    static_configs:
      - targets: ["{{ prometheus_worker_metrics_address }}"]
        labels:
          instance: "traefik:8082"
{% endif %}
{% endif %}

{% include 'configs/prometheus/alertmanager-scrape.yml.j2' %}

{% include 'configs/prometheus/scraparr-scrape.yml.j2' %}

  - job_name: "node-exporter"
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
{% set ns = namespace(hosts=[]) %}
{% for inventory_group in prometheus_node_exporter_inventory_groups | default([]) %}
{% for host in groups.get(inventory_group, []) %}
{% if host not in ns.hosts %}
{% set _ = ns.hosts.append(host) %}
{% endif %}
{% endfor %}
{% endfor %}
{% for host in ns.hosts | sort %}
{% set local_ip = hostvars[host].local_ip | default('') %}
{% if local_ip %}
      - targets: ["{{ local_ip }}:{{ prometheus_node_exporter_port | default(9100) }}"]
        labels:
          instance: "{{ host }}"
          source: "netbox"
{% endif %}
{% endfor %}

  - job_name: "blackbox-http"
    scrape_interval: 1m
    scrape_timeout: 30s
    metrics_path: /probe
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/blackbox-http.json
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"

  - job_name: "blackbox-icmp"
    scrape_interval: 1m
    scrape_timeout: 30s
    metrics_path: /probe
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/blackbox-icmp.json
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"

  - job_name: "blackbox-tcp"
    scrape_interval: 1m
    scrape_timeout: 30s
    metrics_path: /probe
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/blackbox-tcp.json
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"

  - job_name: "postgres-exporter"
    scrape_interval: 30s
    scrape_timeout: 10s
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/postgres.json

{% include 'configs/prometheus/etcd-scrape.yml.j2' %}

  - job_name: "patroni"
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /metrics
    file_sd_configs:
      - files:
          - /etc/prometheus/file_sd/patroni.json

{% if prometheus_blackbox_dns_targets | default({}) | length > 0 %}
  - job_name: "blackbox-dns-udp"
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /probe
    params:
      module:
        - dns_udp_internal_a
    static_configs:
{% for target_name, target_ip in prometheus_blackbox_dns_targets | dictsort %}
      - targets: ["{{ target_ip }}"]
        labels:
          service: technitium
          category: Networking
          probe_type: dns
          criticality: critical
          dns_target: "{{ target_name }}"
          dns_target_ip: "{{ target_ip }}"
          probe: dns_udp_internal_a
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__address__]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"

  - job_name: "blackbox-dns-tcp"
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /probe
    params:
      module:
        - dns_tcp_internal_a
    static_configs:
{% for target_name, target_ip in prometheus_blackbox_dns_targets | dictsort %}
      - targets: ["{{ target_ip }}"]
        labels:
          service: technitium
          category: Networking
          probe_type: dns
          criticality: critical
          dns_target: "{{ target_name }}"
          dns_target_ip: "{{ target_ip }}"
          probe: dns_tcp_internal_a
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__address__]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"
{% endif %}

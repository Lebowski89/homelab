global:
  scrape_interval: 15s
  scrape_timeout: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: "prometheus"
    scrape_interval: 5s
    static_configs:
      - targets: ["prometheus:9090"]

  - job_name: "authelia"
    scrape_interval: 1m
    scrape_timeout: 10s
    static_configs:
      - targets: ["authelia:9959"]

  - job_name: "haproxy"
    scrape_interval: 15s
    metrics_path: /metrics
    static_configs:
      - targets: ["haproxy:8405"]

  - job_name: "traefik"
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
      - targets: ["traefik:8082"]

  - job_name: "alertmanager"
    scrape_interval: 30s
    static_configs:
      - targets: ["alertmanager:9093"]

  - job_name: "node-exporter"
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
{% set ns = namespace(hosts=[]) %}
{% for inventory_group in prometheus_node_exporter_inventory_groups | default([]) %}
{% for host in groups.get(inventory_group, []) %}
{% if host not in ns.hosts %}
{% set _ = ns.hosts.append(host) %}
{% endif %}
{% endfor %}
{% endfor %}
{% for host in ns.hosts | sort %}
{% set local_ip = hostvars[host].local_ip | default('') %}
{% if local_ip %}
      - targets: ["{{ local_ip }}:{{ prometheus_node_exporter_port | default(9100) }}"]
        labels:
          instance: "{{ host }}"
          source: "netbox"
{% endif %}
{% endfor %}

{% if prometheus_blackbox_dns_targets | default({}) | length > 0 %}
  - job_name: "blackbox-dns-udp"
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /probe
    params:
      module:
        - dns_udp_internal_a
    static_configs:
{% for target_name, target_ip in prometheus_blackbox_dns_targets | dictsort %}
      - targets: ["{{ target_ip }}"]
        labels:
          dns_target: "{{ target_name }}"
          dns_target_ip: "{{ target_ip }}"
          probe: dns_udp_internal_a
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__address__]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"

  - job_name: "blackbox-dns-tcp"
    scrape_interval: 30s
    scrape_timeout: 10s
    metrics_path: /probe
    params:
      module:
        - dns_tcp_internal_a
    static_configs:
{% for target_name, target_ip in prometheus_blackbox_dns_targets | dictsort %}
      - targets: ["{{ target_ip }}"]
        labels:
          dns_target: "{{ target_name }}"
          dns_target_ip: "{{ target_ip }}"
          probe: dns_tcp_internal_a
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__address__]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_blackbox_exporter_address }}"
{% endif %}

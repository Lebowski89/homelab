groups:
  - name: node-exporter.rules
    rules:
      - alert: NodeExporterDown
        expr: up{job="node-exporter"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Node exporter down on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Prometheus has been unable to scrape node-exporter on {{ '{{' }} $labels.instance {{ '}}' }} for 5 minutes."
          priority: "9"

      - alert: HostDiskSpaceHigh
        expr: |
          (
            1 -
            (
              node_filesystem_avail_bytes{
                job="node-exporter",
                fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*|rootfs|vfat",
                mountpoint!~"^/(boot|dev|proc|sys|run)($|/)|^/var/lib/docker($|/)"
              }
              /
              node_filesystem_size_bytes{
                job="node-exporter",
                fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*|rootfs|vfat",
                mountpoint!~"^/(boot|dev|proc|sys|run)($|/)|^/var/lib/docker($|/)"
              }
            )
          ) * 100 >= 80
          and on(instance, device, mountpoint, fstype)
          node_filesystem_size_bytes{
            job="node-exporter",
            fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*|rootfs|vfat",
            mountpoint!~"^/(boot|dev|proc|sys|run)($|/)|^/var/lib/docker($|/)"
          } > 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Disk usage high on {{ '{{' }} $labels.instance {{ '}}' }}: {{ '{{' }} $labels.mountpoint {{ '}}' }}"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} humanize $value {{ '}}' }}% full."
          priority: "6"

      - alert: HostDiskSpaceCritical
        expr: |
          (
            1 -
            (
              node_filesystem_avail_bytes{
                job="node-exporter",
                fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*|rootfs|vfat",
                mountpoint!~"^/(boot|dev|proc|sys|run)($|/)|^/var/lib/docker($|/)"
              }
              /
              node_filesystem_size_bytes{
                job="node-exporter",
                fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*|rootfs|vfat",
                mountpoint!~"^/(boot|dev|proc|sys|run)($|/)|^/var/lib/docker($|/)"
              }
            )
          ) * 100 >= 90
          and on(instance, device, mountpoint, fstype)
          node_filesystem_size_bytes{
            job="node-exporter",
            fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*|rootfs|vfat",
            mountpoint!~"^/(boot|dev|proc|sys|run)($|/)|^/var/lib/docker($|/)"
          } > 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Disk usage critical on {{ '{{' }} $labels.instance {{ '}}' }}: {{ '{{' }} $labels.mountpoint {{ '}}' }}"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} humanize $value {{ '}}' }}% full."
          priority: "9"

      - alert: HostLogrotateFailed
        expr: node_systemd_unit_state{job="node-exporter", name=~"logrotate[.]service|skynet-traefik-(logrotate|reopen-logs)[.]service", state="failed"} == 1
        labels:
          severity: warning
        annotations:
          summary: "Log rotation failed on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "{{ '{{' }} $labels.name {{ '}}' }} is failed. Inspect its journal and check that Traefik has reopened its active access log."
          priority: "6"

      - alert: DockerFilesystemHigh
        expr: |
          (
            1 -
            (
              node_filesystem_avail_bytes{job="node-exporter", mountpoint="/var/lib/docker"}
              /
              node_filesystem_size_bytes{job="node-exporter", mountpoint="/var/lib/docker"}
            )
          ) * 100 > 85
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Docker filesystem usage high on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Docker filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} humanize $value {{ '}}' }}% full."
          priority: "6"

      - alert: HostFilesystemReadonly
        expr: node_filesystem_readonly{job="node-exporter", mountpoint!~"/boot|/dev|/proc|/sys|/run"} == 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Filesystem is read-only on {{ '{{' }} $labels.instance {{ '}}' }}: {{ '{{' }} $labels.mountpoint {{ '}}' }}"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has become read-only."
          priority: "10"

      - alert: HostInodesHigh
        expr: |
          (
            1 -
            (
              node_filesystem_files_free{
                job="node-exporter",
                fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*",
                mountpoint!~"/boot|/dev|/proc|/sys|/run|/var/lib/docker/.*"
              }
              /
              node_filesystem_files{
                job="node-exporter",
                fstype!~"tmpfs|overlay|squashfs|nsfs|ramfs|devtmpfs|fuse.*",
                mountpoint!~"/boot|/dev|/proc|/sys|/run|/var/lib/docker/.*"
              }
            )
          ) * 100 > 85
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Inode usage high on {{ '{{' }} $labels.instance {{ '}}' }}: {{ '{{' }} $labels.mountpoint {{ '}}' }}"
          description: "Filesystem {{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} inode usage is {{ '{{' }} humanize $value {{ '}}' }}%."
          priority: "6"

      - alert: HostMemoryHigh
        expr: |
          (
            node_memory_MemAvailable_bytes{job="node-exporter"}
            /
            node_memory_MemTotal_bytes{job="node-exporter"}
          ) * 100 < 20
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Available memory low on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Available memory on {{ '{{' }} $labels.instance {{ '}}' }} has remained below 20% for 15 minutes; sustained memory pressure may lead to an OOM kill."
          priority: "6"

      - alert: HostMemoryCritical
        expr: |
          (
            node_memory_MemAvailable_bytes{job="node-exporter"}
            /
            node_memory_MemTotal_bytes{job="node-exporter"}
          ) * 100 < 10
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Available memory critically low on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Available memory on {{ '{{' }} $labels.instance {{ '}}' }} has remained below 10% for 5 minutes; service or database failure from an OOM kill is imminent."
          priority: "9"

      - alert: HostKernelOomKill
        expr: increase(node_vmstat_oom_kill{job="node-exporter"}[5m]) > 0
        labels:
          severity: critical
        annotations:
          summary: "Kernel OOM kill detected on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "The kernel OOM killer has killed one or more processes on {{ '{{' }} $labels.instance {{ '}}' }} in the last 5 minutes; this may cause service or database failure."
          priority: "10"

      - alert: HostSwapHigh
        expr: |
          (
            1 -
            (
              node_memory_SwapFree_bytes{job="node-exporter"}
              /
              node_memory_SwapTotal_bytes{job="node-exporter"}
            )
          ) * 100 > 50
          and
          node_memory_SwapTotal_bytes{job="node-exporter"} > 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Swap usage high on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Swap usage on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} humanize $value {{ '}}' }}%."
          priority: "6"

      - alert: HostCpuHigh
        expr: |
          (
            1 -
            avg by (instance) (
              rate(node_cpu_seconds_total{job="node-exporter", mode="idle"}[5m])
            )
          ) * 100 > 90
        for: 20m
        labels:
          severity: warning
        annotations:
          summary: "CPU usage high on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "CPU usage on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} humanize $value {{ '}}' }}% over 20 minutes."
          priority: "6"

      - alert: HostLoadHigh
        expr: |
          (
            node_load15{job="node-exporter"}
            /
            count by (instance) (node_cpu_seconds_total{job="node-exporter", mode="idle"})
          ) > 1.5
        for: 20m
        labels:
          severity: warning
        annotations:
          summary: "Load average high on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "15-minute load average on {{ '{{' }} $labels.instance {{ '}}' }} is high relative to CPU count."
          priority: "6"

  - name: native-alloy.rules
    rules:
      - alert: NativeAlloyUnavailable
        expr: |
          label_replace(
            up{job="node-exporter",alloy_native_unit!=""} == 1,
            "name", "$1", "alloy_native_unit", "(.+)"
          )
          unless on(instance, name) node_systemd_unit_state{job="node-exporter",state="active"} == 1
        for: 5m
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Native Alloy service unavailable on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

      - alert: NativeAlloyMetricsMissing
        expr: |
          up{job="node-exporter",alloy_native_metrics_expected="true"}
          unless on(instance) up{job="alloy-native"} == 1
        for: 5m
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Native Alloy metrics missing on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

      - alert: NativeAlloyJournalProbeMissing
        expr: |
          up{job="node-exporter",alloy_journal_probe_expected="true"} == 1
          unless on(instance) (time() - skynet_alloy_journal_probe_timestamp_seconds{job="node-exporter"} < 300)
        for: 5m
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Native Alloy journal probe stale or missing on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

      - alert: NativeAlloyJournalErrors
        expr: |
          (
            skynet_alloy_journal_recent_read_errors{job="node-exporter"} >= 2
            and on(instance) (time() - skynet_alloy_journal_probe_timestamp_seconds{job="node-exporter"} < 300)
          )
          or on(instance)
          sum by(instance) (increase(loki_source_journal_target_parsing_errors_total{job="alloy-native",error="no_message"}[5m])) > 0
        for: 5m
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Sustained native Alloy journal errors on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

      - alert: NativeAlloyLokiDrops
        expr: sum by(instance) (increase(loki_write_dropped_entries_total{job="alloy-native"}[5m])) > 0
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Native Alloy dropped Loki entries on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

      - alert: NativeAlloyLokiRetries
        expr: sum by(instance) (increase(loki_write_batch_retries_total{job="alloy-native"}[5m])) > 0
        for: 5m
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Sustained native Alloy Loki retries on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

      - alert: NativeAlloyIngestionStalled
        expr: |
          (
            increase(loki_source_journal_target_lines_total{job="alloy-native"}[5m]) == 0
            and on(instance) skynet_alloy_journal_recent_activity{job="node-exporter"} == 1
            and on(instance) (time() - skynet_alloy_journal_probe_timestamp_seconds{job="node-exporter"} < 300)
          )
          or on(instance) (
            increase(loki_source_journal_target_lines_total{job="alloy-native"}[5m]) > 0
            unless on(instance) increase(loki_write_sent_entries_total{job="alloy-native"}[5m]) > 0
          )
        for: 10m
        labels:
          severity: warning
          collector: alloy-native
        annotations:
          summary: "Native Alloy ingestion stalled despite activity on {{ '{{' }} $labels.instance {{ '}}' }}"
          priority: "6"

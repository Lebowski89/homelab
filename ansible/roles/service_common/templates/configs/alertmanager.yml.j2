{% set smtp_email = service_common_infisical_values.smtp_email %}
{% set smtp_host = service_common_infisical_values.smtp_host %}
{% set smtp_port = service_common_infisical_values.smtp_port %}
{% set smtp_username = service_common_infisical_values.smtp_username %}
global:
  resolve_timeout: 5m
  smtp_smarthost: "{{ smtp_host }}:{{ smtp_port }}"
  smtp_from: "{{ smtp_username }}"
  smtp_auth_username: "{{ smtp_username }}"
  smtp_auth_password_file: /run/secrets/alertmanager_smtp_password_secret
  smtp_require_tls: true

route:
  receiver: email-gotify
  group_by: [alertname, cluster, service, job, instance, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: email-gotify
      matchers:
        - severity="critical"
      repeat_interval: 1h
    - receiver: email-gotify
      matchers:
        - severity="warning"
      repeat_interval: 6h

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, instance, application_name, slot_name]
  - source_matchers:
      - alertname="PrometheusTargetDown"
    target_matchers:
      - severity=~"warning|critical"
    equal: [job, instance]
  - source_matchers:
      - alertname="BlackboxExporterScrapeFailure"
    target_matchers:
      - alertname="BlackboxProbeFailed"
    equal: [job]
  - source_matchers:
      - alertname="PostgresExporterDown"
    target_matchers:
      - alertname="PostgresQueryUnavailable"
    equal: [instance]

receivers:
  - name: email-gotify
    email_configs:
      - to: "{{ smtp_email }}"
        send_resolved: true
    webhook_configs:
      - url: http://gotify/message
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials_file: /run/secrets/alertmanager_gotify_token_secret
        payload:
          title: '{% raw %}{{ if eq .Status "firing" }}FIRING{{ else }}RESOLVED{{ end }}: {{ .CommonLabels.alertname }}{% endraw %}'
          message: '{% raw %}{{ range .Alerts }}{{ .Annotations.summary }}{{ if .Annotations.description }} - {{ .Annotations.description }}{{ end }}{{ "\n" }}{{ end }}{% endraw %}'
          priority: 8

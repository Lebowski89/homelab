{% set qbittorrent_user = service_common_infisical_values.qbittorrent_user %}
{% set service_common_qbittorrent_data_root = service_common_service.volumes.media.target %}
[Application]
FileLogger\Age=1
FileLogger\AgeType=1
FileLogger\Backup=true
FileLogger\DeleteOld=true
FileLogger\Enabled=true
FileLogger\MaxSizeBytes=66560
FileLogger\Path=/config/log

[AutoRun]
enabled=false
program=

[BitTorrent]
Session\AddTorrentStopped=false
Session\AsyncIOThreadsCount=4
Session\BTProtocol=TCP
Session\CoalesceReadWrite=false
Session\ConnectionSpeed=100
Session\DHTEnabled=false
Session\DefaultSavePath={{ service_common_qbittorrent_data_root }}/completed
Session\DisableAutoTMMByDefault=false
Session\DisableAutoTMMTriggers\CategorySavePathChanged=false
Session\ExcludedFileNames=
Session\FilePoolSize=5000
Session\GlobalUPSpeedLimit=1221
Session\HashingThreadsCount=1
Session\IgnoreSlowTorrentsForQueueing=true
Session\LSDEnabled=false
Session\MaxActiveCheckingTorrents=1
Session\MaxActiveDownloads=3
Session\MaxActiveTorrents=-1
Session\MaxActiveUploads=-1
Session\MaxConnections=-1
Session\MaxConnectionsPerTorrent=24
Session\MaxUploads=-1
Session\MaxUploadsPerTorrent=4
Session\MultiConnectionsPerIp=true
Session\PeXEnabled=false
Session\PieceExtentAffinity=true
Session\Port=
Session\Preallocation=false
Session\QueueingSystemEnabled=true
Session\SlowTorrentsDownloadRate=1024
Session\SlowTorrentsInactivityTimer=300
Session\SlowTorrentsUploadRate=1
Session\SocketBacklogSize=1000
Session\SuggestMode=true
Session\TempPath={{ service_common_qbittorrent_data_root }}/incoming
Session\TempPathEnabled=true
Session\TorrentContentRemoveOption=Delete

[Core]
AutoDeleteAddedTorrentFile=Never

[LegalNotice]
Accepted=true

[Network]
Cookies=@Invalid()
PortForwardingEnabled=false
Proxy\OnlyForTorrents=false

[Meta]
MigrationVersion=8

[Preferences]
Connection\ResolvePeerCountries=false
General\Locale=en
MailNotification\req_auth=true
WebUI\Address=*
WebUI\CSRFProtection=false
WebUI\ClickjackingProtection=false
WebUI\CustomHTTPHeaders=
WebUI\CustomHTTPHeadersEnabled=false
WebUI\HostHeaderValidation=false
WebUI\LocalHostAuth=false
WebUI\Password_PBKDF2={{ service_common_template_vars.qbittorrent_pass_pbkdf2 }}
WebUI\Port={{ service_common_service.traefik.port }}
WebUI\ReverseProxySupportEnabled=true
WebUI\TrustedReverseProxiesList=172.98.0.0/24
WebUI\UseUPnP=false
WebUI\Username={{ qbittorrent_user }}

[RSS]
AutoDownloader\DownloadRepacks=true
AutoDownloader\SmartEpisodeFilter=s(\\d+)e(\\d+), (\\d+)x(\\d+), "(\\d{4}[.\\-]\\d{1,2}[.\\-]\\d{1,2})", "(\\d{1,2}[.\\-]\\d{1,2}[.\\-]\\d{4})"

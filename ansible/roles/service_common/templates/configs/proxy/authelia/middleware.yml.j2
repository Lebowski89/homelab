---

http:
  middlewares:
    authelia:
      forwardAuth:
        address: "http://{{ hostvars[services_controller_host].local_ip }}:19091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - "Remote-User"
          - "Remote-Groups"
          - "Remote-Email"
          - "Remote-Name"
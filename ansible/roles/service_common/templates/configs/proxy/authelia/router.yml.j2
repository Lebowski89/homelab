---

http:
  routers:
    authelia:
      entryPoints: ["https_private"]
      rule: "Host(`authelia.{{ services_internal_zone }}`)"
      priority: 50
      tls:
        options: "securetls@file"
        certResolver: "dns-cloudflare"
      middlewares:
        - "secure-headers@file"
        - "hsts@file"
        - "gzip@file"
      service: "authelia-svc"

  services:
    authelia-svc:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars[services_controller_host].local_ip }}:19091"

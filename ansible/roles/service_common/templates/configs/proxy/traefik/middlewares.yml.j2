---

tls:
  options:
    securetls:
      minVersion: 'VersionTLS12'
      cipherSuites:
        - 'TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256'
        - 'TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256'
        - 'TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384'
        - 'TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384'
        - 'TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305'
        - 'TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305'

http:
  middlewares:
    crowdsec:
      plugin:
        bouncer:
          enabled: true
          logLevel: INFO
          logFormat: json
          crowdsecMode: stream
          crowdsecLapiScheme: http
          crowdsecLapiHost: crowdsec:8080
          crowdsecLapiKeyFile: /run/secrets/crowdsec_traefik_bouncer_key_secret
          crowdsecLapiPath: "/"
          remediationStatusCode: 403
          updateIntervalSeconds: 60
          updateMaxFailure: -1
          httpTimeoutSeconds: 10
          forwardedHeadersTrustedIPs:
            - 173.245.48.0/20
            - 103.21.244.0/22
            - 103.22.200.0/22
            - 103.31.4.0/22
            - 141.101.64.0/18
            - 108.162.192.0/18
            - 190.93.240.0/20
            - 188.114.96.0/20
            - 197.234.240.0/22
            - 198.41.128.0/17
            - 162.158.0.0/15
            - 104.16.0.0/13
            - 104.24.0.0/14
            - 172.64.0.0/13
            - 131.0.72.0/22
            - 2400:cb00::/32
            - 2606:4700::/32
            - 2803:f800::/32
            - 2405:b500::/32
            - 2405:8100::/32
            - 2a06:98c0::/29
            - 2c0f:f248::/32

    gzip:
      compress: {}

    autodetect:
      contentType:
        autoDetect: true

    secure-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: false
        browserXssFilter: false

        customResponseHeaders:
          server: ""
          Permissions-Policy: "geolocation=(), microphone=(), camera=()"
          Referrer-Policy: "no-referrer"

    netbox-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: false
        browserXssFilter: false

        customResponseHeaders:
          server: ""
          Permissions-Policy: "geolocation=(), microphone=(), camera=()"
          Referrer-Policy: "same-origin"

    hsts:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: false
        forceSTSHeader: true

    robots-noindex:
      headers:
        customResponseHeaders:
          X-Robots-Tag: "noindex, nofollow, noarchive, nosnippet"

  serversTransports:
    insecure-skipverify:
      insecureSkipVerify: true
{{ service_common_service.volumes.logs.source }}/access.log {
  daily
  maxsize 25M
  rotate 7
  maxage 7
  missingok
  notifempty
  compress
  delaycompress
{% set execution = (service_common_template_vars | default({})).runtime_execution | default((service_common_service.deploy | default({})).execution | default({'mode': 'rootful'})) %}
  create 0640 {{ execution.host_user if execution.mode == 'rootless' else 'root' }} {{ execution.host_user if execution.mode == 'rootless' else 'root' }}
  sharedscripts
  postrotate
    /usr/local/sbin/skynet-traefik-reopen-logs
  endscript
}

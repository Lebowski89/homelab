/* Homepage custom card/widget darkness */

/* Service cards */
.service-card {
  background: rgba(2, 6, 23, 0.88) !important;
  border: 1px solid rgba(148, 163, 184, 0.22) !important;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
  color: rgba(248, 250, 252, 0.96) !important;
  transition:
    transform 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease !important;
}

/* Service cards on hover */
.service-card:hover {
  background: rgba(15, 23, 42, 0.94) !important;
  border-color: rgba(56, 189, 248, 0.45) !important;
  box-shadow:
    0 0 16px rgba(56, 189, 248, 0.14),
    0 12px 30px rgba(0, 0, 0, 0.62) !important;
  transform: translateY(-2px);
}

/* Bookmark cards */
.bookmark > a {
  background: rgba(2, 6, 23, 0.96) !important;
  border: 1px solid rgba(148, 163, 184, 0.32) !important;
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.65),
    inset 0 0 0 1px rgba(255, 255, 255, 0.03) !important;
  color: rgba(248, 250, 252, 0.98) !important;
  transition:
    transform 0.15s ease,
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease !important;
}

/* Bookmark hover: tiny Skynet glow */
.bookmark:hover > a {
  background: rgba(15, 23, 42, 0.98) !important;
  border-color: rgba(56, 189, 248, 0.55) !important;
  box-shadow:
    0 0 18px rgba(56, 189, 248, 0.18),
    0 10px 28px rgba(0, 0, 0, 0.72) !important;
  transform: translateY(-1px);
}

/* Make bookmark text more readable */
.bookmark > a,
.bookmark > a * {
  color: rgba(248, 250, 252, 0.98) !important;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
}

/* Top widgets / info widgets */
div[class*="widget"],
section[class*="widget"] {
  background: rgba(2, 6, 23, 0.88) !important;
  border: 1px solid rgba(148, 163, 184, 0.22) !important;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45) !important;
  color: rgba(248, 250, 252, 0.96) !important;
}

/* Slight Cyberdyne / terminal feel for group headings */
h2,
[class*="groupTitle"],
[class*="group-title"] {
  color: rgba(125, 211, 252, 0.95) !important;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-shadow:
    0 0 10px rgba(56, 189, 248, 0.28),
    0 2px 4px rgba(0, 0, 0, 0.7);
}

/* Very subtle global vignette to darken bright image edges */
body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background:
    radial-gradient(
      circle at center,
      transparent 35%,
      rgba(0, 0, 0, 0.38) 100%
    ),
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.15),
      rgba(0, 0, 0, 0.38)
    );
}

/* Slightly brighten icons on hover */
.service-card:hover img,
.bookmark:hover img {
  filter: saturate(1.2) contrast(1.08) brightness(1.08);
}
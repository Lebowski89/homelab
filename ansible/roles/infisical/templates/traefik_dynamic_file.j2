---

# Generated by Ansible for {{ infisical_name }}

http:
  middlewares:
    {{ infisical_name }}-ui-chain:
      chain:
        middlewares:
{% if infisical_traefik_crowdsec_enable | bool %}
          - "crowdsec@file"
{% endif %}
{% if infisical_traefik_authelia_enable | bool %}
          - "authelia@file"
{% endif %}
          - "{{ infisical_traefik_headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
          - "gzip@file"

  routers:
    {{ infisical_name }}:
      entryPoints: ["{{ infisical_traefik_entrypoint }}"]
      rule: "Host(`{{ infisical_frontend_fqdn }}`)"
      priority: 20
      tls:
        options: "{{ infisical_traefik_tls_options }}"
        certResolver: "{{ infisical_traefik_certresolver }}"
      middlewares: ["{{ infisical_traefik_middleware_chain }}"]
      service: "{{ infisical_name }}-svc"

  services:
    {{ infisical_name }}-svc:
      loadBalancer:
        servers:
          - url: "{{ infisical_backend_address }}"

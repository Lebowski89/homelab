---

# Generated by Ansible for {{ netbox_name }}

http:
  middlewares:
    {{ netbox_name }}-ui-chain:
      chain:
        middlewares:
{% if netbox_traefik_crowdsec_enable | bool %}
          - "crowdsec@file"
{% endif %}
{% if netbox_traefik_authelia_enable | bool %}
          - "authelia@file"
{% endif %}
          - "{{ netbox_traefik_headers_middleware }}"
          - "robots-noindex@file"
          - "hsts@file"
          - "gzip@file"

  routers:
    {{ netbox_name }}:
      entryPoints: ["{{ netbox_traefik_entrypoint }}"]
      rule: "Host(`{{ netbox_frontend_fqdn }}`)"
      priority: 20
      tls:
        options: "{{ netbox_traefik_tls_options }}"
        certResolver: "{{ netbox_traefik_certresolver }}"
      middlewares: ["{{ netbox_traefik_middleware_chain }}"]
      service: "{{ netbox_name }}-svc"

  services:
    {{ netbox_name }}-svc:
      loadBalancer:
        servers:
          - url: "{{ netbox_backend_address }}"

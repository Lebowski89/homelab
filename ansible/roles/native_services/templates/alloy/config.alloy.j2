logging {
  level  = "info"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "{{ alloy_native_loki_url }}"
  }
}

discovery.relabel "journal" {
  targets = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__systemd_user_unit"]
    target_label  = "user_unit"
  }

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "syslog_identifier"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "priority"
  }

  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }

  // Privacy-sensitive application output remains in the local journal. Entries
  // without these container names, including systemd lifecycle records, remain.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "jdownloader2|mullvad-browser"
    action        = "drop"
  }
}

loki.source.journal "system" {
  max_age       = "24h"
  labels        = {
    host   = constants.hostname,
    source = "journal",
  }
  relabel_rules = discovery.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]
}
{% if alloy_native_prometheus_url | default('') %}

prometheus.scrape "native_metrics" {
  targets = [{
    __address__ = "127.0.0.1:12345",
    instance    = constants.hostname,
  }]
  job_name        = "alloy-native"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.native_metrics.receiver]
}

prometheus.relabel "native_metrics" {
  forward_to = [prometheus.remote_write.native_metrics.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "up|loki_source_journal_target_(lines|parsing_errors)_total|loki_write_(sent_entries|dropped_entries|batch_retries)_total"
    action        = "keep"
  }
}

prometheus.remote_write "native_metrics" {
  endpoint {
    url = {{ alloy_native_prometheus_url | tojson }}
  }
}
{% endif %}

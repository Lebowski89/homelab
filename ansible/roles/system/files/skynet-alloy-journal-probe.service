[Unit]
Description=Report local journal activity and native Alloy read errors
After=systemd-journald.service

[Service]
Type=oneshot
User=node_exporter
Group=node_exporter
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/skynet-alloy-journal-probe
TimeoutStartSec=35s
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile_collector
PrivateTmp=true
PrivateNetwork=true

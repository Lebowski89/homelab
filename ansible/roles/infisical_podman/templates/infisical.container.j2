[Unit]
Description=Infisical container
After=network-online.target {{ infisical_network }}-network.service {{ infisical_postgres_name }}.service {{ infisical_redis_name }}.service
Wants=network-online.target
Requires={{ infisical_network }}-network.service {{ infisical_postgres_name }}.service {{ infisical_redis_name }}.service

[Container]
ContainerName={{ infisical_name }}
Image={{ infisical_image }}
Network={{ infisical_network }}
PublishPort={{ infisical_port }}:8080
Environment=TZ={{ timezone }}
Environment=NODE_ENV=production
EnvironmentFile={{ infisical_path }}/.env

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

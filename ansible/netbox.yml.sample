---

## NetBox Dynamic Inventory for Ansible
## See docs/netbox.md for details

plugin: netbox.netbox.nb_inventory

api_endpoint: https://netbox.example.com
token: REPLACE_ME

validate_certs: false

interfaces: true
virtual_chassis: false

query_filters:
  - has_primary_ip: 'true'

group_by:
  - device_roles
  - tags

# Build Ansible variables from NetBox data
compose:
  ansible_host: custom_fields['tailscale_ip'] | default(primary_ip4.address | regex_replace('/.*', ''), true)
  ansible_user: custom_fields['ansible_user'] | default('mgt', true)
  ansible_port: custom_fields['ssh_port'] | default('22', true)
  local_ip: primary_ip4.address | regex_replace('/.*', '')

  container_host_puid: >-
    custom_fields['container_host_puid'] | default(custom_fields['docker_host_puid'], true) | default(omit, true)
  container_host_pgid: >-
    custom_fields['container_host_pgid'] | default(custom_fields['docker_host_pgid'], true) | default(omit, true)
  container_host_appdata_root: >-
    custom_fields['container_host_appdata_root'] | default(custom_fields['docker_host_appdata_root'], true) | default(omit, true)
  container_host_data_root: >-
    custom_fields['container_host_data_root'] | default(custom_fields['docker_host_data_root'], true) | default(omit, true)

  docker_host_puid: custom_fields['docker_host_puid'] | default(omit, true)
  docker_host_pgid: custom_fields['docker_host_pgid'] | default(omit, true)
  docker_host_appdata_root: custom_fields['docker_host_appdata_root'] | default(omit, true)
  docker_host_data_root: custom_fields['docker_host_data_root'] | default(omit, true)

  keepalived_priority_dns_vip_a: custom_fields['keepalived_priority_dns_vip_a'] | default(omit, true)
  keepalived_priority_dns_vip_b: custom_fields['keepalived_priority_dns_vip_b'] | default(omit, true)

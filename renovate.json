{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "timezone": "Australia/Melbourne",
    "dependencyDashboard": true,
    "labels": [
        "renovate"
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/examples/**",
        "**/fixtures/**",
        "**/collections/**",
        "**/ansible/collections/**",
        "**/.ansible/**"
    ],
    "prConcurrentLimit": 5,
    "prHourlyLimit": 1,
    "branchConcurrentLimit": 5,
    "rangeStrategy": "pin",
    "semanticCommits": "enabled",
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps",
    "commitBodyTable": true,
    "minimumReleaseAge": "3 days",
    "separateMajorMinor": true,
    "separateMinorPatch": true,
    "prBodyNotes": [
        "Homelab note: review upstream release notes/changelog before merging."
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "extends": [
            "schedule:monthly"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.ya?ml$/"
            ],
            "matchStrings": [
                "image:\\s*[\"']?(?<depName>[^\"'\\s:@]+(?:\\/[^\"'\\s:@]+)*)\\s*:(?<currentValue>[^\"'\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?"
            ],
            "datasourceTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/ansible\\/roles\\/ubuntu\\/tasks\\/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "-\\s*(?<depName>[A-Za-z0-9._-]+)==(?<currentValue>[^\\s\"']+)"
            ],
            "datasourceTemplate": "pypi",
            "versioningTemplate": "pep440"
        }
    ],
    "packageRules": [
        {
            "description": "Group Terraform/OpenTofu providers and modules",
            "matchManagers": [
                "terraform"
            ],
            "matchDepTypes": [
                "required_provider",
                "module"
            ],
            "groupName": "terraform providers and modules",
            "addLabels": [
                "terraform"
            ],
            "groupSlug": "terraform-providers-modules",
            "schedule": [
                "* 3-7 * * 1"
            ],
            "prPriority": -2
        },
        {
            "description": "Do not update Terraform/OpenTofu required_version constraints; managed manually as a range.",
            "matchManagers": [
                "terraform"
            ],
            "matchDepTypes": [
                "required_version"
            ],
            "enabled": false
        },
        {
            "description": "Label Terraform/OpenTofu updates",
            "matchManagers": [
                "terraform"
            ],
            "addLabels": [
                "terraform"
            ]
        },
        {
            "description": "Automerge GitHub Actions minor/patch updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "github actions minor/patch updates",
            "groupSlug": "github-actions-minor-patch",
            "schedule": [
                "* 3-7 * * 1"
            ],
            "prPriority": -4,
            "addLabels": [
                "github-actions",
                "automerge"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true
        },
        {
            "description": "Require dependency dashboard approval for major GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true,
            "prPriority": 5,
            "addLabels": [
                "github-actions",
                "major"
            ]
        },
        {
            "description": "Do not automerge Docker updates",
            "matchDatasources": [
                "docker"
            ],
            "automerge": false
        },
        {
            "description": "Do not split Docker updates by major/minor/patch",
            "matchDatasources": [
                "docker"
            ],
            "separateMajorMinor": false,
            "separateMinorPatch": false,
            "separateMultipleMajor": false,
            "separateMultipleMinor": false
        },
        {
            "description": "Require dependency dashboard approval for major Docker updates",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true,
            "prPriority": 20,
            "addLabels": [
                "docker",
                "major"
            ]
        },
        {
            "description": "Label Docker minor updates",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "prPriority": 0,
            "addLabels": [
                "docker",
                "minor"
            ]
        },
        {
            "description": "Label Docker patch updates",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "prPriority": -1,
            "addLabels": [
                "docker",
                "patch"
            ]
        },
        {
            "description": "Weekly batch for non-critical Docker minor/patch updates",
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "weekly non-critical docker image updates",
            "groupSlug": "weekly-docker-minor-patch",
            "schedule": [
                "* 3-7 * * 1"
            ],
            "minimumGroupSize": 2,
            "prPriority": -5,
            "addLabels": [
                "docker",
                "batch"
            ],
            "matchPackageNames": [
                "!postgres",
                "!docker.io/library/postgres",
                "!valkey/valkey",
                "!traefik",
                "!docker.io/library/traefik",
                "!authelia/authelia",
                "!docker.io/infisical/infisical",
                "!infisical/infisical",
                "!lscr.io/linuxserver/netbox",
                "!lscr.io/linuxserver/plex",
                "!prom/prometheus",
                "!prom/alertmanager",
                "!grafana/grafana",
                "!grafana/loki",
                "!grafana/alloy",
                "!haproxy",
                "!docker.io/library/haproxy",
                "!crowdsecurity/crowdsec",
                "!portainer/portainer-ce"
            ]
        },
        {
            "description": "Keep critical infrastructure and database images separate",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "postgres",
                "docker.io/library/postgres",
                "valkey/valkey",
                "traefik",
                "docker.io/library/traefik",
                "authelia/authelia",
                "docker.io/infisical/infisical",
                "infisical/infisical",
                "lscr.io/linuxserver/netbox",
                "lscr.io/linuxserver/plex",
                "prom/prometheus",
                "prom/alertmanager",
                "grafana/grafana",
                "grafana/loki",
                "grafana/alloy",
                "haproxy",
                "docker.io/library/haproxy",
                "crowdsecurity/crowdsec",
                "portainer/portainer-ce"
            ],
            "groupName": null,
            "addLabels": [
                "docker",
                "critical"
            ]
        },
        {
            "description": "Use target version in Traefik branch names",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "traefik",
                "docker.io/library/traefik"
            ],
            "branchTopic": "{{{depNameSanitized}}}-{{{newVersion}}}",
            "groupName": null,
            "prPriority": 10,
            "addLabels": [
                "traefik"
            ]
        },
        {
            "description": "Hotio versioned release tags",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "/^ghcr\\.io\\/hotio\\//"
            ],
            "versioning": "regex:^(?:(?<compatibility>v\\d+)-)?(?:release-v?)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:(?:-release)?\\.(?<build>\\d+))?$"
        },
        {
            "description": "LinuxServer versioned tags",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "/^lscr\\.io\\/linuxserver\\//"
            ],
            "allowedVersions": "!/^development-.*$/",
            "versioning": "regex:^(?:(?<compatibility>[a-z]+)-)?v?(?<major>\\d+)\\.(?<minor>\\d+)(?:[.-](?<patch>\\d+))?(?:-ls(?<build>\\d+))?$",
            "addLabels": [
                "linuxserver"
            ]
        },
        {
            "description": "Require dependency dashboard approval for Python major updates",
            "matchDatasources": [
                "pypi"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true,
            "prPriority": -1,
            "addLabels": [
                "python",
                "major"
            ]
        },
        {
            "description": "Automerge Python patch/minor updates",
            "matchDatasources": [
                "pypi"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "python package minor/patch updates",
            "groupSlug": "python-package-minor-patch",
            "addLabels": [
                "python",
                "automerge"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "prPriority": -4
        }
    ]
}

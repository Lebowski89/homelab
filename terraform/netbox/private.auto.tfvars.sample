internal_zone = "int.domain.com"

host_private_values = {
  router = {
    mgmt_ip = "192.168.##.1/24"

    custom_fields = {}
  }

  mgt = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user             = "user"
      ssh_port                 = "22"
      tailscale_ip             = "100.xx.xx.xx"
      docker_host_puid         = "1000"
      docker_host_pgid         = "1000"
      docker_host_appdata_root = "/opt"
      docker_host_data_root    = "/opt"
      dns_priority             = "010"
    }
  }

  unraid = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user             = "user"
      ssh_port                 = "22"
      tailscale_ip             = "100.xx.xx.xx"
      docker_host_puid         = "99"
      docker_host_pgid         = "100"
      docker_host_appdata_root = "/mnt/user/appdata"
      docker_host_data_root    = "/mnt/user/data"
    }
  }

  plex = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user             = "user"
      ssh_port                 = "22"
      tailscale_ip             = "100.xx.xx.xx"
      docker_host_puid         = "1000"
      docker_host_pgid         = "1000"
      docker_host_appdata_root = "/opt"
      docker_host_data_root    = "/opt"
      dns_priority             = "020"
    }
  }

  pve1 = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user = "user"
      ssh_port     = "22"
      tailscale_ip = "100.xx.xx.xx"
    }
  }

  pg95 = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user = "user"
      ssh_port     = "22"
      tailscale_ip = "100.xx.xx.xx"
    }
  }

  pg96 = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user = "user"
      ssh_port     = "22"
      tailscale_ip = "100.xx.xx.xx"
    }
  }

  pg97 = {
    mgmt_ip = "192.168.xx.xx/24"

    custom_fields = {
      ansible_user = "user"
      ssh_port     = "22"
      tailscale_ip = "100.xx.xx.xx"
    }
  }
}

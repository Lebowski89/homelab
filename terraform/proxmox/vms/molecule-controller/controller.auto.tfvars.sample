# Copy to the approved private deployment directory, never use as a secret file.
# Add pm_api_token there from the dedicated controller-provisioning identity.
pm_api_url        = "https://192.168.80.80:8006/"
pm_ssh_username   = "root"
pm_ssh_host       = "192.168.80.80"
target_node       = "pve1"
vm_name           = "molecule-controller"
vm_id             = 9300
vm_storage        = "local-zfs"
snippet_storage   = "local"
vm_cpu_cores      = 2
vm_memory_mb      = 4096
vm_disk_size_gb   = 32
vm_network_bridge = "vmbr1"
# Resolve .41/24, router and DNS from NetBox after its scoped host registration.
ssh_public_key_path      = "/private/molecule-controller/controller-admin.pub"
vm_host_key_private_path = "/private/molecule-controller/controller-host-ed25519"

pm_api_url      = "https://192.168.xx.xx:8006/"
pm_ssh_username = "user"
pm_ssh_host     = "100.00.00.00"
pm_tls_insecure = true

# Normally the selected staging host's address, router and DNS come from NetBox.
# Set netbox_state_path privately if the authoritative snapshot is elsewhere.
# When that host is not yet in NetBox, supply approved staging overrides:
# vm_ipv4_address            = "192.0.2.10/24"
# vm_ipv4_gateway            = "192.0.2.1"
# vm_nameservers             = ["192.0.2.53"]
# vm_search_domain           = "lab.example.invalid"
# enable_netbox_remote_state = false

---

scope: {{ pgha_patroni_scope }}
namespace: {{ pgha_patroni_namespace }}
name: {{ pgha_patroni_node_name }}

restapi:
  listen: 0.0.0.0:{{ pgha_patroni_restapi_port }}
  connect_address: {{ local_ip }}:{{ pgha_patroni_restapi_port }}

etcd3:
  hosts:
{% for host in pgha_patroni_etcd_hosts %}
    - {{ host }}
{% endfor %}

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
{% for key, value in pgha_patroni_postgresql_parameters.items() %}
        {{ key }}: {{ value }}
{% endfor %}
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:{{ pgha_patroni_postgres_port }}
  connect_address: {{ local_ip }}:{{ pgha_patroni_postgres_port }}
  data_dir: {{ pgha_patroni_data_dir }}
  bin_dir: {{ pgha_patroni_bin_dir }}
  authentication:
    superuser:
      username: {{ pgha_patroni_superuser_name }}
      password: {{ pgha_patroni_superuser_pass }}
    replication:
      username: {{ pgha_patroni_replication_name }}
      password: {{ pgha_patroni_replication_pass }}
  parameters:
{% for key, value in pgha_patroni_postgresql_parameters.items() %}
    {{ key }}: {{ value }}
{% endfor %}

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false

profile: production

exclude_paths:
  - .git/
  - .github/
  - ansible-venv/
  - discards/

mock_modules:
  - yedit
  - find_open_port
  - qbittorrent_passwd

warn_list:
  - fqcn-builtins

skip_list:
  - yaml[line-length]
  - var-naming[no-role-prefix]
  - name[casing]
  - key-order[task]
  - command-instead-of-module
  - no-changed-when

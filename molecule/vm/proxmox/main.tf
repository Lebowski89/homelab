terraform {
  required_version = "~> 1.11.0"
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "0.120.0"
    }
  }
}

variable "run" {
  description = "Validated, non-secret run manifest generated by vm.py. No implicit allocation."
  type = object({
    id                  = string, node = string, template_id = number, bridge = string, ssh_host = string,
    storage             = string, image_storage = string, snippet_storage = string,
    gateway             = string, dns = list(string), public_key = string,
    python_requirements = string,
    image_file_id       = optional(string)
    image_local_path    = optional(string)
    image               = object({ url = string, checksum = string, algorithm = string, disk_gb = number, user = string, distribution = string }),
    guests              = map(object({ vm_id = number, address = string }))
  })
}

variable "guest_ssh_host_key" {
  description = "Unique disposable-guest host key delivered only through authenticated cloud-init. Private run state is sensitive."
  type        = object({ private = string, public = string })
  sensitive   = true
}

provider "proxmox" {
  # PROXMOX_VE_ENDPOINT/API_TOKEN/SSH_USERNAME are supplied only to OpenTofu.
  insecure = false
  ssh {
    agent    = true
    username = "root"
    node {
      name    = var.run.node
      address = var.run.ssh_host
      port    = 22
    }
  }
}

resource "proxmox_download_file" "image" {
  count              = var.run.image_file_id == null && var.run.image_local_path == null ? 1 : 0
  content_type       = "iso"
  datastore_id       = var.run.image_storage
  node_name          = var.run.node
  file_name          = "molecule-${var.run.id}.img"
  url                = var.run.image.url
  checksum           = var.run.image.checksum
  checksum_algorithm = var.run.image.algorithm
  overwrite          = false
}

resource "proxmox_virtual_environment_file" "image" {
  count        = var.run.image_local_path != null ? 1 : 0
  content_type = "iso"
  datastore_id = var.run.image_storage
  node_name    = var.run.node
  overwrite    = false
  source_file {
    path      = var.run.image_local_path
    file_name = "molecule-${var.run.id}.img"
    checksum  = var.run.image.checksum
  }
}

resource "proxmox_virtual_environment_vm" "template" {
  vm_id       = var.run.template_id
  name        = "molecule-${var.run.id}-template"
  description = "homelab-molecule:${var.run.id}:template"
  node_name   = var.run.node
  tags        = ["molecule", "run-${var.run.id}"]
  template    = true
  started     = false
  on_boot     = false
  bios        = "ovmf"
  machine     = "q35"
  efi_disk {
    datastore_id      = var.run.storage
    type              = "4m"
    pre_enrolled_keys = false
  }
  cpu {
    cores = 2
    type  = "host"
  }
  memory {
    dedicated = 2048
  }
  serial_device {}
  initialization {
    upgrade      = false
    datastore_id = var.run.storage
    user_account {
      username = var.run.image.user
      keys     = [var.run.public_key]
    }
  }
  network_device {
    bridge = var.run.bridge
  }
  disk {
    datastore_id = var.run.storage
    interface    = "scsi0"
    file_format  = "raw"
    file_id = (var.run.image_file_id != null ? var.run.image_file_id :
    var.run.image_local_path != null ? proxmox_virtual_environment_file.image[0].id : proxmox_download_file.image[0].id)
    size = var.run.image.disk_gb
  }
  boot_order    = ["scsi0"]
  scsi_hardware = "virtio-scsi-single"
}

module "guest" {
  for_each = var.run.guests
  # vm.py copies the existing module unchanged into the private run directory.
  source     = "./cloudinit-vm"
  depends_on = [proxmox_virtual_environment_file.network]

  name                               = "molecule-${var.run.id}-${each.key}"
  description                        = "homelab-molecule:${var.run.id}:${each.key}"
  vm_id                              = each.value.vm_id
  node_name                          = var.run.node
  clone_template_vm_id               = proxmox_virtual_environment_vm.template.vm_id
  tags                               = ["molecule", "run-${var.run.id}"]
  on_boot                            = false
  bios                               = "ovmf"
  machine                            = "q35"
  memory_mb                          = 2048
  datastore_id                       = var.run.storage
  disk_size_gb                       = 32
  snippet_datastore_id               = var.run.snippet_storage
  ipv4_address                       = each.value.address
  ipv4_gateway                       = var.run.gateway
  dns_servers                        = var.run.dns
  cloud_init_upgrade                 = false
  network_data_file_id               = var.run.image.distribution == "Ubuntu" ? "${var.run.snippet_storage}:snippets/molecule-${var.run.id}-network.yaml" : null
  cloud_init_user                    = var.run.image.user
  ssh_public_keys                    = [var.run.public_key]
  network_bridge                     = var.run.bridge
  vendor_data_file_id                = proxmox_virtual_environment_file.bootstrap.id
  qemu_guest_agent_bootstrap_enabled = false
}

# The pinned Ubuntu image brings ens18 up in its initrd. Proxmox's generated
# v1 data asks cloud-init to rename that active link to eth0, which fails.
# Use standard v2 data without set-name; keep the approved allocation explicit.
resource "proxmox_virtual_environment_file" "network" {
  count        = var.run.image.distribution == "Ubuntu" ? 1 : 0
  content_type = "snippets"
  datastore_id = var.run.snippet_storage
  node_name    = var.run.node
  overwrite    = false
  source_raw {
    file_name = "molecule-${var.run.id}-network.yaml"
    data = jsonencode({
      version = 2
      ethernets = {
        ens18 = {
          match       = { name = "ens18" }
          dhcp4       = false
          addresses   = [var.run.guests.subject.address]
          routes      = [{ to = "default", via = var.run.gateway }]
          nameservers = { addresses = var.run.dns }
        }
      }
    })
  }
}

resource "proxmox_virtual_environment_file" "bootstrap" {
  content_type = "snippets"
  datastore_id = var.run.snippet_storage
  node_name    = var.run.node
  overwrite    = false
  file_mode    = "0600"
  source_raw {
    file_name = "molecule-${var.run.id}-bootstrap.yaml"
    data = format("#cloud-config\n%s", yamlencode({
      package_update  = true
      package_upgrade = false
      ssh_keys        = { ed25519_private = var.guest_ssh_host_key.private, ed25519_public = var.guest_ssh_host_key.public }
      packages = concat(["qemu-guest-agent", "python3", "ca-certificates"],
        var.run.image.distribution == "Fedora" ? ["python3-libdnf5", "python3-pip"] :
      var.run.image.distribution == "Rocky" ? ["python3-dnf", "python3-pip"] : ["python3-apt", "python3-venv"])
      # Ubuntu cloud-init 26.1 treats every nonempty bootcmd as requiring an
      # early network wait, before sysinit. With native firewalld this deadlocks
      # networkd -> network-pre -> firewalld -> sysinit -> cloud-init-network.
      # Ubuntu has no update-ca-trust; leave this RPM preparation out there.
      bootcmd = var.run.image.distribution == "Ubuntu" ? [] : [["sh", "-c", "if command -v update-ca-trust >/dev/null 2>&1; then update-ca-trust extract; fi"]]
      users = [{ name = "molecule", groups = "", sudo = "ALL=(ALL) NOPASSWD:ALL", shell = "/bin/bash", lock_passwd = true,
      ssh_authorized_keys = [var.run.public_key] }]
      write_files = [
        { path = "/var/lib/homelab-molecule-vm", owner = "root:root", permissions = "0600", content = "${var.run.id}\n" },
        { path = "/etc/homelab-molecule-python-requirements.txt", owner = "root:root", permissions = "0644", content = var.run.python_requirements }
      ]
      # Distribution bindings remain available to APT/DNF/RPM modules. SDK and
      # stack-module dependencies use existing repository pins, without EPEL or
      # changes to the distribution's externally managed Python environment.
      runcmd = [
        ["python3", "-m", "venv", "--system-site-packages", "/opt/homelab-molecule-ansible"],
        ["/opt/homelab-molecule-ansible/bin/pip", "install", "--disable-pip-version-check", "--no-input", "--requirement", "/etc/homelab-molecule-python-requirements.txt"],
        ["systemctl", "enable", "--now", "qemu-guest-agent"]
      ]
    }))
  }
}

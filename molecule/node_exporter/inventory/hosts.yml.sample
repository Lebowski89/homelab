---

# Copy outside Git and fill from the disposable VM's verified inventory identity.
# Use vm.py/suite.py --os to supply the selected platform and generated guest vars;
# direct Molecule calls also require HOMELAB_MOLECULE_VARS pointing to those vars.
all:
  children:
    molecule_node_exporter:
      hosts:
        molecule-node-exporter:
          ansible_host: 192.0.2.10
          ansible_user: molecule
          ansible_port: 22
          ansible_connection: ssh
          molecule_node_exporter_disposable: true
    tags_skynet:
      children:
        molecule_node_exporter: {}
    tags_node_exporter:
      children:
        molecule_node_exporter: {}
